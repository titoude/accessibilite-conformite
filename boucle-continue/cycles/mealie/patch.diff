+  const whiteRatio = 1.05 / (lum + 0.05);
+  const blackRatio = (lum + 0.05) / 0.05;
+  return blackRatio >= whiteRatio ? "rgba(0, 0, 0, 0.87)" : "#ffffff";
+});
 </script>
