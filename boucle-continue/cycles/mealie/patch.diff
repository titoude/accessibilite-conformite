diff --git a/frontend/app/app.vue b/frontend/app/app.vue
new file mode 100644
index 000000000..eabb9dda6
--- /dev/null
+++ b/frontend/app/app.vue
@@ -0,0 +1,72 @@
+<template>
+  <NuxtLayout>
+    <NuxtPage />
+  </NuxtLayout>
+</template>
+
+<script setup lang="ts">
+// Pose lang/dir sur <html> (WCAG 3.1.1) en suivant la locale active.
+const { locale } = useI18n();
+useHead({
+  htmlAttrs: {
+    lang: computed(() => locale.value),
+    dir: "ltr",
+  },
+});
+</script>
+
+<style>
+/* Les overlays v-tooltip dormants portent role="tooltip" sans nom accessible
+   (leur contenu n'est rendu qu'à l'activation) : hors activation on les
+   masque complètement pour qu'ils ne soient ni exposés ni flagués. */
+.v-overlay.v-tooltip:not(.v-overlay--active) {
+  display: none !important;
+}
+
+/* Les labels de champ héritent de la couleur primary (orange #E58325 ≈ 3,4:1)
+   quand le champ est actif : insuffisant. On les force sur on-surface
+   à emphase moyenne (≈7:1 clair / ≈9:1 sombre). */
+.v-field-label,
+.v-messages__message {
+  color: rgba(var(--v-theme-on-surface), var(--v-high-emphasis-opacity));
+}
+/* Labels de champ : teinte pleine — ils flottent sur fonds variés
+   (barre d'appli, cartes) et doivent tenir 4,5:1 partout. */
+.v-field-label,
+.v-field-label.text-primary {
+  color: rgb(var(--v-theme-on-surface)) !important;
+}
+/* Les liens .text-primary (≈ 4,4:1 sous le seuil 4,5) sont assombri à 82%
+   de la couleur secondary (≈ 6:1) ; les liens en texte courant gardent
+   leur couleur mais sont soulignés (déjà couvert par SafeMarkdown). */
+a.text-primary,
+.v-list a.text-primary {
+  color: color-mix(in srgb, rgb(var(--v-theme-secondary)) 82%, black) !important;
+}
+
+
+/* Boutons texte/elevated : assombrir les couleurs de thème trop claires
+   pour un texte blanc ou primaire (ratio ≥ 4,5:1). */
+.v-btn--variant-text.text-primary,
+.v-btn--variant-plain.text-primary {
+  color: color-mix(in srgb, rgb(var(--v-theme-primary)) 70%, black) !important;
+}
+.v-btn.bg-success {
+  background-color: color-mix(in srgb, rgb(var(--v-theme-success)) 78%, black) !important;
+}
+.v-btn.bg-error {
+  background-color: color-mix(in srgb, rgb(var(--v-theme-error)) 75%, black) !important;
+}
+
+.sr-only {
+  position: absolute;
+  width: 1px;
+  height: 1px;
+  padding: 0;
+  margin: -1px;
+  overflow: hidden;
+  clip: rect(0, 0, 0, 0);
+  white-space: nowrap;
+  border: 0;
+}
+</style>
