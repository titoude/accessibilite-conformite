diff --git a/packages/nc-gui/utils/iconUtils.ts b/packages/nc-gui/utils/iconUtils.ts
index 7c22e3c..1dbabca 100644
--- a/packages/nc-gui/utils/iconUtils.ts
+++ b/packages/nc-gui/utils/iconUtils.ts
@@ -4803,3 +4803,37 @@ export type IconMapKey = keyof typeof iconMap
 export function resolveIconMapKey(icon?: string): IconMapKey | undefined {
   return icon && icon in iconMap ? (icon as IconMapKey) : undefined
 }
+
+// Source .svg assets ship hard-coded <defs> ids ("Vector", "Social Icons"…).
+// Every rendered copy duplicates them document-wide — suffix each id and every
+// url(#…)/#… reference with a per-call counter so repeated icons stay unique.
+let ncSvgIdSeq = 0
+export function scopeSvgIds(root: Element | null | undefined): void {
+  if (!root) return
+  // Scope each <svg> independently: a container holding several copies of the
+  // same icon must give each copy its own suffix, not share one remapping.
+  const svgs: Element[] = root.tagName === 'svg' ? [root] : [...root.querySelectorAll('svg')]
+  for (const svg of svgs) {
+    const map = new Map<string, string>()
+    svg.querySelectorAll('[id]').forEach((el) => {
+      const old = el.id
+      if (!map.has(old)) map.set(old, `${old}-nci${++ncSvgIdSeq}`)
+    })
+    if (!map.size) continue
+    svg.querySelectorAll('[id]').forEach((el) => {
+      el.id = map.get(el.id)!
+    })
+    svg.querySelectorAll('*').forEach((el) => {
+      for (const attr of ['fill', 'stroke', 'clip-path', 'filter', 'mask', 'marker-start', 'marker-mid', 'marker-end']) {
+        const v = el.getAttribute(attr)
+        if (v && v.includes('url(#')) {
+          el.setAttribute(attr, v.replace(/url\(#([^)]+)\)/g, (_m, id) => `url(#${map.get(id) ?? id})`))
+        }
+      }
+      for (const attr of ['href', 'xlink:href', 'aria-labelledby', 'aria-describedby']) {
+        const v = el.getAttribute(attr)
+        if (v && v.startsWith('#')) el.setAttribute(attr, `#${map.get(v.slice(1)) ?? v.slice(1)}`)
+      }
+    })
+  }
+}
