@@ -40,3 +40,17 @@ For Drag and Drop
 .flex.hidden {
   display: none;
 }
+
+/*
+WCAG AA: EE plan badges ship inline text colours under 4.5:1 on their tinted
+backgrounds (Business #C44DA0 on #FFF0FB = 3.89:1, Scale #5B5DEF on #EEEFEFD =
+4.32:1). The badge component itself is not in this tree, so the fix lands by
+class against those same tint backgrounds.
+*/
+.nc-upgrade-badge.Business-badge {
+  color: #a7357e !important; /* 5.53:1 on #FFF0FB */
+}
+
+.nc-upgrade-badge.Scale-badge {
+  color: #4b4fd6 !important; /* 5.43:1 on #EEEFEFD */
+}
