+// Icon-only triggers keep their name in the tooltip instead of the a11y tree.
+// Mirror it onto the trigger as aria-label — only when the trigger has no text
+// and no accessible name of its own, so labelled buttons are untouched.
+// Nameable targets only: a bare div[tabindex] has the generic role, which
+// cannot carry an accessible name (aria-prohibited-attr) — hence [role] rather
+// than [tabindex] in the selector.
+const syncTriggerLabel = () => {
+  const root = (el.value instanceof HTMLElement ? el.value : el.value?.$el) as HTMLElement | undefined
+  const text = tooltipText.value
+  if (!root || !text) return
+  const trigger = (
+    root.matches('button, a[href], input, select, textarea, [role]:not([role="none"]):not([role="presentation"]):not([role="generic"])')
+      ? root
+      : root.querySelector('button, a[href], input, select, textarea, [role]:not([role="none"]):not([role="presentation"]):not([role="generic"])')
+  ) as HTMLElement | null
+  if (!trigger) return
+  if (trigger.getAttribute('aria-label') || trigger.getAttribute('aria-labelledby') || trigger.getAttribute('title'))
+    return
+  if (trigger.textContent?.trim()) return
+  trigger.setAttribute('aria-label', text)
+}
+
+onMounted(syncTriggerLabel)
+onUpdated(syncTriggerLabel)
 </script>
 
