@@ -0,0 +1,16 @@
+// The default layout renders a fallback sr-only <h1> bound to the document
+// title so every page has a level-one heading (page-has-heading-one). Pages
+// whose content already renders a visible <h1> — i.e. through NcPageHeader —
+// register their route here so the fallback doesn't produce two h1s.
+export const usePageH1 = () => {
+  const h1Owner = useState<string | null>('nc-page-h1-owner', () => null)
+
+  const registerPageH1 = (path: string) => {
+    h1Owner.value = path
+  }
+
+  return {
+    h1Owner,
+    registerPageH1,
+  }
+}
