diff --git a/templates/Entry/search.html.twig b/templates/Entry/search.html.twig
new file mode 100644
index 000000000..e0487005a
--- /dev/null
+++ b/templates/Entry/search.html.twig
@@ -0,0 +1,31 @@
+{% extends "layout.html.twig" %}
+
+{% block title %}{{ 'menu.top.search'|trans }}{% endblock %}
+
+{% block content %}
+    <div class="row">
+        <div class="col s12">
+            <form class="input-field" name="search" method="GET" action="{{ path('search') }}">
+                {% if form_errors(form) %}
+                    <span class="black-text">{{ form_errors(form) }}</span>
+                {% endif %}
+
+                {% if form_errors(form.term) %}
+                    <span class="black-text">{{ form_errors(form.term) }}</span>
+                {% endif %}
+
+                <input type="hidden" name="currentRoute" value="{{ currentRoute }}" />
+
+                {{ form_widget(form.term, {'id': 'search_page_term', 'attr': {'autocomplete': 'off', 'placeholder': 'entry.search.placeholder'|trans}}) }}
+                <label for="search_page_term">{{ 'menu.top.search'|trans }}</label>
+
+                {{ form_rest(form) }}
+
+                <button class="btn waves-effect waves-light" type="submit">
+                    {{ 'menu.top.search'|trans }}
+                    <i class="material-icons right">search</i>
+                </button>
+            </form>
+        </div>
+    </div>
+{% endblock %}
