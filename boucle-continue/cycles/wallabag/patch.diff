index b297fcbfe..4436d6c82 100644
--- a/assets/scss/_various.scss
+++ b/assets/scss/_various.scss
@@ -51,3 +51,132 @@ nav .input-field input {
     background: none;
   }
 }
+
+/* ==========================================================================
+ * Accessible palette overrides (WCAG AA >= 4.5 contrast on white)
+ * The classes keep their Materialize names; only the color values change.
+ * ========================================================================== */
+
+.grey-text {
+  color: #6e6e6e !important;
+}
+
+.grey {
+  background-color: #6e6e6e !important;
+}
+
+.cyan.darken-1,
+.cyan.darken-2 {
+  background-color: variables.$blue-accent-color !important;
+}
+
+.teal,
+.teal.darken-1 {
+  background-color: #00796b !important;
+}
+
+.light-green.darken-1 {
+  background-color: #4a7c28 !important;
+}
+
+.light-blue.darken-1 {
+  background-color: #0277bd !important;
+}
+
+.green.darken-1 {
+  background-color: #2e7d32 !important;
+}
+
+.blue.darken-1 {
+  background-color: #1565c0 !important;
+}
+
+.blue-grey {
+  background-color: #546e7a !important;
+}
+
+.red {
+  background-color: #d32f2f !important;
+}
+
+/* tab links: Materialize ships translucent/light red on white */
+.tabs .tab a {
+  color: #c62828;
+
+  &:focus,
+  &.active {
+    color: #b71c1c;
+  }
+
+  &:hover {
+    color: #b71c1c;
+  }
+}
+
+/* card action links (default amber accent is below AA on white) */
+.card .card-action a:not(.btn):not(.btn-large):not(.btn-small):not(.btn-floating) {
+  color: #b06000 !important;
+}
+
+/* … but card-action links on a colored card stay white */
+.card.cyan .card-action a:not(.btn):not(.btn-small):not(.btn-large):not(.btn-floating),
+.card.teal .card-action a:not(.btn):not(.btn-small):not(.btn-large):not(.btn-floating),
+.card.green .card-action a:not(.btn):not(.btn-small):not(.btn-large):not(.btn-floating),
+.card.light-green .card-action a:not(.btn):not(.btn-small):not(.btn-large):not(.btn-floating),
+.card.light-blue .card-action a:not(.btn):not(.btn-small):not(.btn-large):not(.btn-floating),
+.card.blue .card-action a:not(.btn):not(.btn-small):not(.btn-large):not(.btn-floating),
+.card.blue-grey .card-action a:not(.btn):not(.btn-small):not(.btn-large):not(.btn-floating),
+.card.red .card-action a:not(.btn):not(.btn-small):not(.btn-large):not(.btn-floating),
+.card.grey .card-action a:not(.btn):not(.btn-small):not(.btn-large):not(.btn-floating) {
+  color: #fff !important;
+}
+
+/* form labels and select dropdown items */
+label,
+.input-field > label {
+  color: #6e6e6e;
+}
+
+.dropdown-content li > a,
+.dropdown-content li > span {
+  color: #007c91;
+}
+
+/* primary buttons */
+.btn,
+.btn-large,
+.btn-small,
+.btn-floating {
+  background-color: #00796b;
+
+  &:hover {
+    background-color: #00695c;
+  }
+
+  &:focus {
+    background-color: #1d7d74;
+  }
+}
+
+.btn-floating:hover {
+  background-color: #00695c;
+}
+
+/* standalone page title inside the login card (kept small, like a card title) */
+.login-title {
+  font-size: 1.6rem;
+  margin: 0.5rem 0;
+}
+
+/* footer: opaque text on the dark cyan strip (alpha-blended colors fail AA) */
+.page-footer {
+  color: #fff;
+
+  .footer-copyright {
+    color: #fff;
+  }
+
+  .grey-text.text-lighten-4 {
+    color: #fff !important;
+  }
+}
