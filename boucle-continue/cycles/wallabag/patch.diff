--- a/assets/controllers/materialize/form_select_controller.js
+++ b/assets/controllers/materialize/form_select_controller.js
@@ -3,7 +3,18 @@ import M from '@materializecss/materialize';
 
 export default class extends Controller {
   connect() {
-    this.instance = M.FormSelect.init(this.element.querySelector('select'));
+    const select = this.element.querySelector('select');
+    this.instance = M.FormSelect.init(select);
+
+    // Materialize points the field label at the generated dropdown input,
+    // leaving the real <select> unnamed. Keep it associated by reference.
+    const label = this.element.querySelector('label');
+    if (label) {
+      if (!label.id) {
+        label.id = `${select.id}-label`;
+      }
+      select.setAttribute('aria-labelledby', label.id);
+    }
   }
 
   disconnect() {
