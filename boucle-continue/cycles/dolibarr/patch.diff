diff --git a/htdocs/core/js/lib_head.js.php b/htdocs/core/js/lib_head.js.php
index 1a0c8a2..503d61d 100644
--- a/htdocs/core/js/lib_head.js.php
+++ b/htdocs/core/js/lib_head.js.php
@@ -1907,4 +1907,169 @@ $(function() {
 
 }
 
+
+// a11y cycle 57 — fixes runtime : noms accessibles + liaisons select2 + h1
+(function () {
+	var selLabel = <?php echo json_encode($langs->trans('Select')); ?>;
+	var menuLabel = <?php echo json_encode($langs->trans('Menu')); ?>;
+	var searchLabel = <?php echo json_encode($langs->trans('Search')); ?>;
+
+	function labelFromTitle(el) {
+		var t = el.getAttribute('title');
+		if (t && t.replace(/<[^>]*>/g, '').trim() !== '') { return t.replace(/<[^>]*>/g, '').trim(); }
+		return null;
+	}
+
+	function fixSearchInputs() {
+		document.querySelectorAll('input[name^="search"], select[name^="search"], input.select2-search__field, input.checkforselect, input[name="toselect[]"]').forEach(function (el) {
+			if (el.getAttribute('aria-label') || el.getAttribute('aria-labelledby')) { return; }
+			var label = labelFromTitle(el);
+			if (!label) {
+				var td = el.closest('th, td');
+				var th = td && td.closest('tr') ? null : null;
+				// colonne parente : texte du th de la colonne
+				var cell = el.closest('td, th');
+				if (cell) {
+					var idx = Array.prototype.indexOf.call(cell.parentNode.children, cell);
+					var table = cell.closest('table');
+					if (table) {
+						var headTh = table.querySelector('tr.liste_titre th:nth-child(' + (idx + 1) + '), thead th:nth-child(' + (idx + 1) + ')');
+						if (headTh && headTh.textContent.trim()) { label = headTh.textContent.trim(); }
+					}
+				}
+			}
+			if (!label && el.classList.contains('checkforselect')) { label = selLabel; }
+			if (!label) { label = searchLabel; }
+			if (el.getAttribute('aria-label') !== label) { el.setAttribute('aria-label', label); }
+		});
+		// label-title-only : title sans autre nom
+		document.querySelectorAll('input[title]:not([aria-label]):not([aria-labelledby]), select[title]:not([aria-label]):not([aria-labelledby])').forEach(function (el) {
+			var t = labelFromTitle(el);
+			if (t) { el.setAttribute('aria-label', t); }
+		});
+		// lignes de formulaire legacy <td>libelle</td><td><input/></td> : nom accessible depuis la cellule precedente
+		document.querySelectorAll('#id-right input:not([aria-label]):not([aria-labelledby]), #id-right select:not([aria-label]):not([aria-labelledby]), #id-right textarea:not([aria-label]):not([aria-labelledby])').forEach(function (el) {
+			if (el.type === 'hidden' || el.getAttribute('aria-hidden') === 'true' || el.closest('[aria-hidden="true"]')) { return; }
+			var cell = el.closest('td, th');
+			var lbl = null;
+			if (cell) {
+				var prev = cell.previousElementSibling;
+				while (prev && !lbl) {
+					var txt = (prev.textContent || '').replace(/[*  ]+/g, ' ').trim();
+					if (txt) { lbl = txt; }
+					prev = prev.previousElementSibling;
+				}
+			}
+			if (!lbl && el.placeholder) { lbl = el.placeholder; }
+			if (!lbl && el.name) { lbl = el.name.replace(/[_-]+/g, ' '); }
+			if (!lbl) { lbl = el.id ? el.id.replace(/[_-]+/g, ' ') : selLabel; }
+			el.setAttribute('aria-label', lbl);
+		});
+	}
+
+	function fixSelect2() {
+		// Liaison aria-controls/aria-owns : supprime les references vers des id absents du DOM
+		document.querySelectorAll('span.select2-selection[role="combobox"]').forEach(function (cb) {
+			['aria-controls', 'aria-owns'].forEach(function (attr) {
+				var ref = cb.getAttribute(attr);
+				if (ref && !document.getElementById(ref)) { cb.removeAttribute(attr); }
+			});
+			var host = cb.closest('.select2-container');
+			var sel = host ? host.previousElementSibling : null;
+			var lbl = null;
+			if (sel && sel.id) {
+				var lab = document.querySelector('label[for="' + sel.id + '"]');
+				if (lab && lab.textContent.trim()) { lbl = lab.textContent.trim(); }
+			}
+			if (!lbl && sel && sel.getAttribute('data-placeholder')) { lbl = sel.getAttribute('data-placeholder'); }
+			if (!lbl && sel && sel.name) { lbl = searchLabel; }
+			var newLbl = lbl || selLabel;
+			// aria-labelledby pointant vers un contenu vide ne nomme rien -> on le remplace
+			var by = cb.getAttribute('aria-labelledby');
+			var byEmpty = by && by.split(' ').every(function (id) {
+				var el = document.getElementById(id);
+				return el ? el.textContent.trim() === '' : true;
+			});
+			if (by && byEmpty) { cb.removeAttribute('aria-labelledby'); }
+			if ((!cb.getAttribute('aria-label') && !cb.getAttribute('aria-labelledby')) || byEmpty) {
+				if (cb.getAttribute('aria-label') !== newLbl) { cb.setAttribute('aria-label', newLbl); }
+			}
+			if (!cb.hasAttribute('aria-expanded')) { cb.setAttribute('aria-expanded', 'false'); }
+			// le span rendu (role=textbox) herite du meme nom
+			var rendered = cb.querySelector('.select2-selection__rendered');
+			if (rendered && rendered.getAttribute('role') === 'textbox') {
+				var rby = rendered.getAttribute('aria-labelledby');
+				var rbyOk = rby && rby.split(' ').some(function (id) {
+					var el = document.getElementById(id);
+					return el && el !== rendered && el.textContent.trim() !== '';
+				});
+				if (!rendered.getAttribute('aria-label') && !rbyOk && rendered.getAttribute('aria-label') !== newLbl) {
+					rendered.setAttribute('aria-label', newLbl);
+				}
+			}
+			// liaison aria-controls -> la liste de resultats correspondante
+			var rid = rendered && rendered.id ? rendered.id.replace(/-container$/, '-results') : null;
+			if (rid && document.getElementById(rid) && !cb.hasAttribute('aria-controls')) {
+				cb.setAttribute('aria-controls', rid);
+			}
+		});
+		// popup select2 ouvert attache a <body> : role dialog (hors landmarks sinon)
+		document.querySelectorAll('body > span.select2-container--open:not([role]), body > .select2-container.select2-container--open:not([role])').forEach(function (pop) {
+			pop.setAttribute('role', 'dialog');
+			pop.setAttribute('aria-label', selLabel);
+		});
+		// listbox vide : role retire tant qu'il n'y a pas d'option (aria-required-children)
+		document.querySelectorAll('ul.select2-results__options').forEach(function (ul) {
+			var hasOpts = !!ul.querySelector('[role="option"], li.select2-results__option');
+			if (!hasOpts && ul.getAttribute('role') === 'listbox') {
+				ul.setAttribute('data-a11y-role', 'listbox');
+				ul.removeAttribute('role');
+			} else if (hasOpts && ul.getAttribute('data-a11y-role') === 'listbox') {
+				ul.setAttribute('role', 'listbox');
+				ul.removeAttribute('data-a11y-role');
+			}
+		});
+		// Liste d'options : li messages hors role=option
+		document.querySelectorAll('.select2-results__options > li.select2-results__message:not([role="option"])').forEach(function (li) {
+			li.setAttribute('role', 'option');
+			li.setAttribute('aria-disabled', 'true');
+			if (li.hasAttribute('aria-live')) { li.removeAttribute('aria-live'); }
+		});
+	}
+
+	function ensureH1() {
+		var main = document.getElementById('id-right');
+		if (!main) { return; }
+		if (!main.querySelector('h1')) {
+			var h1 = document.createElement('h1');
+			h1.className = 'sr-only';
+			var title = document.querySelector('#id-right .titre, #id-right .print-barre-liste');
+			h1.textContent = (title && title.textContent.trim()) || document.title.replace(/\s*-\s*[^-]*$/, '');
+			main.prepend(h1);
+		}
+	}
+
+	function run() {
+		fixSearchInputs(); fixSelect2(); ensureH1();
+		document.addEventListener('keydown', function(e) {
+			if (e.key !== 'Escape') return;
+			var open = document.querySelectorAll('.dropdown.open');
+			for (var i = 0; i < open.length; i++) { open[i].classList.remove('open'); }
+		});
+		if (!window.__a11yObs && document.body) {
+			window.__a11yObs = true;
+			new MutationObserver(function () {
+				clearTimeout(window.__a11yObsT);
+				window.__a11yObsT = setTimeout(function () { fixSearchInputs(); fixSelect2(); }, 50);
+			}).observe(document.body, {
+				childList: true, subtree: true, attributes: true,
+				attributeFilter: ['aria-controls', 'aria-owns', 'aria-expanded', 'aria-labelledby', 'role', 'class', 'title']
+			});
+		}
+	}
+	if (document.readyState === 'loading') {
+		document.addEventListener('DOMContentLoaded', run);
+	} else { run(); }
+})();
+
 // End of lib_head.js.php
