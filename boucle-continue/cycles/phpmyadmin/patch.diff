diff --git a/public/themes/pmahomme/scss/_common.scss b/public/themes/pmahomme/scss/_common.scss
index 5bf39db..ffb65de 100644
--- a/public/themes/pmahomme/scss/_common.scss
+++ b/public/themes/pmahomme/scss/_common.scss
@@ -2542,3 +2542,121 @@ code.sql,
 code.xml {
   color: var(--#{$prefix}code-color);
 }
+
+// WCAG 2.5.8: 24px minimum target size for native checkboxes/radios
+input[type="checkbox"],
+input[type="radio"] {
+  min-width: 24px;
+  min-height: 24px;
+}
+
+// WCAG 2.5.8: the widened input would butt against its label — keep a gap
+// so the full 24px box stays unobscured.
+input[type="checkbox"].form-check-input,
+input[type="radio"].form-check-input {
+  margin-right: 4px;
+}
+
+// WCAG 2.5.8: 24px hit area for the 16px "Documentation" icon links
+a[target="mysql_doc"],
+a[target="documentation"] {
+  display: inline-block;
+  padding: 5px;
+}
+
+// WCAG 2.5.8: short text links used as standalone rows items
+.list-group-item > a[rel="noopener noreferrer"],
+.list-group-item > a[target="_blank"] {
+  display: inline-block;
+  padding: 5px 0;
+}
+
+// WCAG 1.4.1: links inside running text must be distinguishable
+// without relying on color alone.
+a[href^="mailto:"],
+#li_pma_version a,
+#li_pma_version_git a,
+.latest a,
+.card-header > a,
+.card-body a:not(.btn),
+h2 > a,
+.alert a {
+  text-decoration-line: underline;
+}
+
+// WCAG 1.4.3: Bootstrap's #dc3545 fails on white (4.0); code pink
+// #d63384 fails on white (4.1) and on alert backgrounds.
+.text-danger {
+  // !important: Bootstrap utilities are !important too
+  color: #a41e2b !important;
+}
+
+.form-check-label code,
+.alert code,
+code.sql {
+  color: inherit;
+}
+// WCAG 1.4.3: Bootstrap muted tones (.form-text, .text-body-secondary,
+// .card-subtitle) measure ~4.08 on the #eeeeee panel surfaces.
+.form-text,
+.text-body-secondary,
+.card-subtitle {
+  color: #52575c !important;
+}
+// WCAG 2.5.8: dropdown menu items and table sort links must reach 24px.
+.dropdown-menu .dropdown-item {
+  min-height: 24px;
+}
+
+th .sortlink,
+th a.sortlink {
+  display: inline-block;
+  padding: 5px 0;
+}
+// WCAG 1.4.3: CodeMirror gutter line numbers are #999 (2.85:1) on white.
+.CodeMirror-linenumber {
+  color: #6c6c6c;
+}
+
+// WCAG 1.4.1: row action links (Edit/Copy/Delete) inside table cells.
+td a.delete_row,
+td a.edit_row_anchor,
+td .text-nowrap > a {
+  text-decoration-line: underline;
+}
+// WCAG 2.5.8 hit-area: Bootstrap rounds .form-check-input (50% radios,
+// .25em checkboxes) — the rounded corners fall outside the painted shape,
+// so the 24px box is flagged partially obscured. Square the box; the
+// visible control stays square-ish (appearance:none paints the glyph).
+.form-check-input[type="radio"],
+.form-check-input[type="checkbox"] {
+  border-radius: 0;
+}
+// WCAG 2.5.8 hit-area: consecutive .form-check rows are ~21.7px apart;
+// the 24px inputs would overlap each other. Force a >=24px pitch.
+.form-check {
+  min-height: 24px;
+}
+// WCAG 1.4.1: "Sort" links inside table headers need a non-color cue.
+th a[title="Sort"] {
+  text-decoration-line: underline;
+}
+// WCAG 2.5.8 index-links: Edit/Rename/Drop index links render ~19px tall.
+tr.noclick td a,
+td.edit_index a,
+td.rename_index a {
+  display: inline-block;
+  min-height: 24px;
+  line-height: 24px;
+}
+// WCAG 2.5.8 noclick-row-pitch: index action links are 24px tall; give the
+// rows a 24px line so they don't overflow into the next row.
+td.noclick {
+  line-height: 24px;
+}
+
+// WCAG 1.4.3 null-cells: #7d7d7d italic NULL text fails on striped rows.
+td.null {
+  color: #6c6c6c !important;
+}
+
