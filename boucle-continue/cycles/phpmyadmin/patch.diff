+#pma_navigation_tree_content div.block a,
+#pma_navigation_tree_content a.expander {
+  display: inline-block;
+  min-width: 24px;
+  min-height: 24px;
+  line-height: 24px;
+  text-align: center;
+}
+// WCAG 2.5.8 navtree-second-anchor: the absolute left:.75em hangs the
+// 24px link outside its .block and under the db-name link.
+#pma_navigation_tree div.block > a,
+#pma_navigation_tree_content div.block > a {
+  left: 0;
+  right: auto;
+}
+#pma_navigation_tree div.block.second.double > a,
+#pma_navigation_tree_content div.block.second.double > a {
+  left: 0;
+}
+#pma_navigation_tree div.block.second.double > a + a,
+#pma_navigation_tree_content div.block.second.double > a + a {
+  left: 24px;
+}
+#pma_navigation_tree div.block.second.double {
+  min-width: 48px;
+}
+// WCAG 2.5.8 navtree-anchor-top: absolute top:50% hung the 24px link 12px
+// into the next row, where the sibling name link could cover it.
+#pma_navigation_tree div.block > a,
+#pma_navigation_tree_content div.block > a {
+  top: 0;
+}
+
+// WCAG 2.5.8 nav-header-icons: 16px dot.gif icon links in the panel header.
+#navipanellinks a,
+#pma_navigation_header a,
+a.logout,
+#pma_navigation_content a[title="Home"],
+a[title^="phpMyAdmin documentation"],
+a[title="MariaDB Documentation"] {
+  display: inline-block;
+  min-width: 24px;
+  min-height: 24px;
+  line-height: 24px;
+  text-align: center;
+}
+
