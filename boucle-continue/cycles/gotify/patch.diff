new file mode 100644
index 0000000..582fe6e
--- /dev/null
+++ b/ui/src/common/visuallyHidden.ts
@@ -0,0 +1,17 @@
+import {CSSProperties} from 'react';
+
+/**
+ * Rend un libellé invisible à l'écran mais lisible par les lecteurs d'écran.
+ * Utilisé pour les en-têtes de colonnes purement iconiques (axe `empty-table-header`).
+ */
+export const visuallyHidden: CSSProperties = {
+    border: 0,
+    clip: 'rect(0 0 0 0)',
+    height: 1,
+    margin: -1,
+    overflow: 'hidden',
+    padding: 0,
+    position: 'absolute',
+    whiteSpace: 'nowrap',
+    width: 1,
+};
