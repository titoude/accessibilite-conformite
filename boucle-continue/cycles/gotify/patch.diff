diff --git a/ui/src/common/popupContainer.ts b/ui/src/common/popupContainer.ts
new file mode 100644
index 0000000..08c4d72
--- /dev/null
+++ b/ui/src/common/popupContainer.ts
@@ -0,0 +1,14 @@
+/**
+ * Élément hôte des overlays (Dialog, Menu, Drawer temporaire, snackbars).
+ *
+ * Frère de #root dans index.html : les modales MUI ne mettent en aria-hidden
+ * que leurs propres siblings — montés ici, ils ne masquent jamais #root et
+ * restent dans un landmark `complementary` (règle axe `region`).
+ */
+export const popupContainer = (): HTMLElement => {
+    const el = document.getElementById('a11y-popup-layer');
+    if (!el) {
+        throw new Error('#a11y-popup-layer absent du document');
+    }
+    return el;
+};
