diff --git a/web_src/css/helpers.css b/web_src/css/helpers.css
index 42d06e2e66..1d11e84306 100644
--- a/web_src/css/helpers.css
+++ b/web_src/css/helpers.css
@@ -58,3 +58,154 @@ Gitea's private styles use `g-` prefix.
 .tab-size-14 { tab-size: 14 !important; }
 .tab-size-15 { tab-size: 15 !important; }
 .tab-size-16 { tab-size: 16 !important; }
+
+/* Visually-hidden but AT-readable text (screen-reader only). */
+.tw-sr-only {
+	position: absolute !important;
+	width: 1px !important;
+	height: 1px !important;
+	padding: 0 !important;
+	margin: -1px !important;
+	overflow: hidden !important;
+	clip: rect(0, 0, 0, 0) !important;
+	white-space: nowrap !important;
+	border: 0 !important;
+}
+
+/* WCAG 2.5.8: interactive targets must be at least 24x24 CSS pixels.
+   Padding expands the hit area; negative margins keep layout unchanged. */
+.markup .anchor {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  width: 24px;
+  height: 24px;
+  padding-right: 0;
+  margin-left: -24px;
+}
+
+.flex-item-body a.index,
+.issue-list-body a.index {
+  display: inline-block;
+  min-width: 24px;
+  min-height: 24px;
+  padding: 3px 4px;
+  margin: -3px -4px;
+}
+
+a.issue-title {
+  display: inline-block;
+  padding: 3px 0;
+  margin: -3px 0;
+}
+
+.ui.table td .tw-flex a[data-tooltip-content],
+.ui.table td a[aria-label] {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  min-width: 24px;
+  min-height: 24px;
+  padding: 2px;
+  margin: -2px;
+}
+
+/* WCAG 1.4.1: links inside text blocks must be distinguishable without color.
+   Scoped to feed/text contexts where plain links sit inside body text. */
+.dashboard.feeds .flex-item a,
+.profile .flex-item a,
+.ui.form .help a,
+.ui.info.message a,
+.comment-header .time-desc a,
+.time-desc a,
+#pull-desc-display a,
+.issue-content .flex-item p a,
+.issue-content .desc p a,
+.activity .list a,
+.list p a,
+p a,
+.ui.segment > a,
+.ui.attached.info.segment a,
+.ui.attached.segment.header .field a,
+.markup p a,
+.markup li a {
+  text-decoration: underline;
+}
+
+/* WCAG 2.5.8: standalone small links/controls need a 24x24 target.
+   Inline links inside a sentence are exempt; these are not inline.
+   Positive (not negative) margins so neighbors never obscure the target. */
+a.archive-link,
+.dropdown-list-end a,
+.ui.table td a,
+.flex-item .flex-item-body a,
+.flex-item .labels-list a,
+.time-desc a,
+a:has(> .team-name),
+button.btn[data-clipboard-text] {
+  display: inline-flex;
+  align-items: center;
+  min-height: 24px;
+  padding: 2px 4px;
+  margin: 0 2px;
+}
+button.btn[data-clipboard-text] {
+  min-width: 24px;
+  justify-content: center;
+}
+
+/* Sidebar full-width dropdown triggers (milestone/label filters) */
+.ui.dropdown.full-width > a,
+.ui.dropdown.full-width > .text,
+.ui.dropdown.full-width > .flex-item {
+  min-height: 24px;
+  display: flex;
+  align-items: center;
+}
+
+/* WCAG 1.4.3: disabled widgets still must keep readable text.
+   Fomantic dims whole .disabled components with --opacity-disabled (0.55),
+   blending every child below 4.5:1. Keep them opaque and show the disabled
+   state with readable muted tokens instead. */
+.ui.form .disabled.fields .field,
+.ui.form .disabled.field,
+.ui.form .field.disabled,
+.ui.form .fields.disabled > label,
+.ui.form .field.disabled > label,
+.ui.form .field :disabled {
+  opacity: 1;
+}
+/* fomantic marks these opacity rules !important — our override needs it too */
+.ui.buttons .disabled.button:not(.basic),
+.ui.disabled.button,
+.ui.disabled.active.button,
+.ui.labeled.button.disabled,
+.ui.dropdown.disabled,
+.ui.menu .item.disabled,
+.ui.dropdown .menu > .item.disabled {
+  opacity: 1 !important;
+}
+.ui.form .disabled.field :is(label, .help, .text, .ui.input input, input, code),
+.ui.form .field.disabled > label,
+.ui.labeled.button.disabled > .button,
+.ui.dropdown.disabled > .text,
+.ui.dropdown.disabled > .icon,
+.ui.menu .item.disabled,
+.ui.dropdown .menu > .item.disabled {
+  color: var(--color-text-light-3) !important;
+}
+.ui.button.disabled,
+.ui.disabled.button {
+  color: var(--color-text-light-2);
+  background: var(--color-button);
+  border-color: var(--color-secondary-dark-2);
+}
+
+/* Dropdown trigger text and disabled menu items must stay >= 4.5:1 (WCAG 1.4.3) */
+.ui.dropdown > .text,
+.ui.dropdown > a.text {
+  color: var(--color-text);
+}
+.ui.dropdown .menu > .item.disabled {
+  color: var(--color-text-light-3) !important;
+}
