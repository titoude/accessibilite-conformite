diff --git a/ui/bin/patch-ra-a11y.mjs b/ui/bin/patch-ra-a11y.mjs
new file mode 100644
index 0000000..a44cd5d
--- /dev/null
+++ b/ui/bin/patch-ra-a11y.mjs
@@ -0,0 +1,131 @@
+// Postinstall patch: accessibility fixes inside ra-ui-materialui (react-admin v3).
+// React-admin renders some controls with incorrect ARIA wiring that cannot be
+// overridden from application code:
+//   - Datagrid select-all / row checkboxes put aria-label on the <span> wrapper
+//     (aria-label on a role-less span is prohibited) while the <input> stays
+//     unlabeled -> move the label into inputProps.
+//   - Loading-skeleton checkboxes ship completely unlabeled inputs.
+//   - The page title renders as h6 text instead of an h1 (page-has-heading-one).
+//   - SearchInput labels the search field with placeholder text only
+//     (label-title-only) -> give the input an aria-label, overridable via props.
+// Applied to both the CommonJS (lib/) and ESM (esm/) builds the bundler may use.
+// Idempotent: each replacement is a no-op when already applied.
+import fs from 'node:fs'
+import path from 'node:path'
+import { fileURLToPath } from 'node:url'
+
+const uiDir = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..')
+const raDir = path.join(uiDir, 'node_modules', 'ra-ui-materialui')
+
+let patched = 0
+let skipped = 0
+
+const edit = (relPath, pairs) => {
+  const file = path.join(raDir, relPath)
+  if (!fs.existsSync(file)) {
+    skipped++
+    return
+  }
+  let src = fs.readFileSync(file, 'utf8')
+  for (const [find, replace] of pairs) {
+    if (src.includes(replace)) continue
+    if (!src.includes(find)) {
+      console.warn(`[patch-ra-a11y] pattern not found in ${relPath}: ${find.slice(0, 80)}`)
+      continue
+    }
+    src = src.split(find).join(replace)
+    patched++
+  }
+  fs.writeFileSync(file, src)
+}
+
+const headerCheckbox = [
+  [
+    `"aria-label": translate('ra.action.select_all', {`,
+    `inputProps: { 'aria-label': translate('ra.action.select_all', {`,
+  ],
+  [
+    `}), className: "select-all"`,
+    `}) }, className: "select-all"`,
+  ],
+]
+
+const rowCheckbox = [
+  [
+    `"aria-label": translate('ra.action.select_row', {`,
+    `inputProps: { 'aria-label': translate('ra.action.select_row', {`,
+  ],
+  [
+    `}), color: "primary", className: "select-item "`,
+    `}) }, color: "primary", className: "select-item "`,
+  ],
+]
+
+const loadingCheckboxes = () => [
+  [
+    `React.createElement(Checkbox, { className: "select-all", color: "primary", checked: false })`,
+    `React.createElement(Checkbox, { className: "select-all", color: "primary", checked: false, inputProps: { 'aria-label': 'Select all' } })`,
+  ],
+  [
+    `React.createElement(core_1.Checkbox, { className: "select-all", color: "primary", checked: false })`,
+    `React.createElement(core_1.Checkbox, { className: "select-all", color: "primary", checked: false, inputProps: { 'aria-label': 'Select all' } })`,
+  ],
+]
+
+for (const build of ['lib', 'esm']) {
+  edit(`${build}/list/datagrid/DatagridHeader.js`, headerCheckbox)
+  // The bulk-select header cell contains only a checkbox -> empty-table-header.
+  // Give the <th> itself an accessible name.
+  edit(`${build}/list/datagrid/DatagridHeader.js`, [
+    [
+      `React.createElement(TableCell, { padding: "checkbox", className: classes.headerCell },`,
+      `React.createElement(TableCell, { padding: "checkbox", className: classes.headerCell, 'aria-label': translate('ra.action.select_all', { _: 'Select all' }) },`,
+    ],
+    [
+      `React.createElement(core_1.TableCell, { padding: "checkbox", className: classes.headerCell },`,
+      `React.createElement(core_1.TableCell, { padding: "checkbox", className: classes.headerCell, 'aria-label': translate('ra.action.select_all', { _: 'Select all' }) },`,
+    ],
+  ])
+  edit(`${build}/list/datagrid/DatagridRow.js`, rowCheckbox)
+  edit(`${build}/list/datagrid/DatagridLoading.js`, loadingCheckboxes())
+
+  // h1 on the page title rendered by the AppBar
+  edit(`${build}/layout/AppBar.js`, [
+    [
+      `{ variant: "h6", color: "inherit", className: classes.title, id: "react-admin-title" }`,
+      `{ variant: "h6", component: "h1", color: "inherit", className: classes.title, id: "react-admin-title" }`,
+    ],
+  ])
+
+  // Error screen: h1 with role="alert" is an invalid role on a heading —
+  // a div keeps the same live-region announcement.
+  edit(`${build}/layout/Error.js`, [
+    [
+      `React.createElement("h1", { className: classes.title, role: "alert" }`,
+      `React.createElement("div", { className: classes.title, role: "alert" }`,
+    ],
+  ])
+
+  // Bulk toolbar: "N items selected" uses variant=subtitle1 which renders an
+  // <h6> and breaks the page's heading order. component="p" keeps the style.
+  edit(`${build}/list/BulkActionsToolbar.js`, [
+    [
+      `React.createElement(Typography, { color: "inherit", variant: "subtitle1" }`,
+      `React.createElement(Typography, { component: "p", color: "inherit", variant: "subtitle1" }`,
+    ],
+    [
+      `React.createElement(Typography_1.default, { color: "inherit", variant: "subtitle1" }`,
+      `React.createElement(Typography_1.default, { component: "p", color: "inherit", variant: "subtitle1" }`,
+    ],
+  ])
+
+  // aria-label on the global search input (placeholder-only label today)
+  edit(`${build}/input/SearchInput.js`, [
+    [
+      `placeholder: translate('ra.action.search'), InputProps: {`,
+      `placeholder: translate('ra.action.search'), inputProps: { 'aria-label': translate('ra.action.search') }, InputProps: {`,
+    ],
+  ])
+}
+
+console.log(`[patch-ra-a11y] ${patched} replacement(s) applied, ${skipped} file(s) missing`)
