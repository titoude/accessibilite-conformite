 };
+
+interface PaletteSearchInputProps {
+  className?: string;
+  defaultPlaceholder?: string;
+  onChange?: ChangeEventHandler<HTMLInputElement>;
+  onKeyDown?: KeyboardEventHandler<HTMLInputElement>;
+}
+
+/**
+ * Local fork of kbar's `KBarSearch` input (same role as the
+ * `PaletteResultsList` fork of `KBarResults`). Upstream renders
+ * `role="combobox"`, `aria-controls` and `aria-activedescendant`
+ * unconditionally — while the palette is in a skeleton/empty state or
+ * mid-transition, `#kbar-listbox` and the referenced item are absent from
+ * the document and the ids dangle (`aria-valid-attr-value`). A combobox
+ * also requires `aria-controls` to resolve. This fork keeps the combobox
+ * semantics in sync with the targets that actually exist: without a
+ * rendered listbox the element is a plain search input; the
+ * `aria-activedescendant` ref is only emitted while the referenced item is
+ * in the document.
+ */
+function PaletteSearchInput(props: PaletteSearchInputProps) {
+  const {
+    query,
+    search,
+    actions,
+    currentRootActionId,
+    activeIndex,
+    showing,
+    options,
+  } = useKBar((state) => ({
+    search: state.searchQuery,
+    currentRootActionId: state.currentRootActionId,
+    actions: state.actions,
+    activeIndex: state.activeIndex,
+    showing: state.visualState === VisualState.showing,
+  }));
+
+  const [inputValue, setInputValue] = useState(search);
+  useEffect(() => {
+    query.setSearch(inputValue);
+  }, [inputValue, query]);
+
+  useEffect(() => {
+    query.setSearch("");
+    query.getInput().focus();
+    return () => query.setSearch("");
+  }, [currentRootActionId, query]);
+
+  const { defaultPlaceholder, ...rest } = props;
+
+  const placeholder = currentRootActionId
+    ? actions[currentRootActionId]?.name
+    : (defaultPlaceholder ?? "Type a command or search…");
+
+  const activeItemId =
+    activeIndex >= 0 ? getListboxItemId(activeIndex) : undefined;
+  const [idrefs, setIdrefs] = useState({ listbox: false, item: false });
+
+  useEffect(() => {
+    const update = () =>
+      setIdrefs({
+        listbox: !!document.getElementById(KBAR_LISTBOX),
+        item:
+          activeItemId !== undefined &&
+          !!document.getElementById(activeItemId),
+      });
+    update();
+    const observer = new MutationObserver(update);
+    observer.observe(document.body, { childList: true, subtree: true });
+    return () => observer.disconnect();
+  }, [activeItemId]);
+
+  const isCombobox = idrefs.listbox;
+
+  return (
+    <input
+      {...rest}
+      ref={query.inputRefSetter}
+      autoFocus
+      autoComplete="off"
+      role={isCombobox ? "combobox" : undefined}
+      spellCheck="false"
+      aria-expanded={isCombobox ? showing : undefined}
+      aria-controls={isCombobox ? KBAR_LISTBOX : undefined}
+      aria-activedescendant={idrefs.item ? activeItemId : undefined}
+      value={inputValue}
+      placeholder={placeholder}
+      onChange={(event) => {
+        props.onChange?.(event);
+        setInputValue(event.target.value);
+        options?.callbacks?.onQueryChange?.(event.target.value);
+      }}
+      onKeyDown={(event) => {
+        props.onKeyDown?.(event);
+        if (currentRootActionId && !search && event.key === "Backspace") {
+          const parent = actions[currentRootActionId].parent;
+          query.setCurrentRootAction(parent);
+        }
+      }}
+    />
+  );
+}
