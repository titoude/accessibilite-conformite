diff --git a/frontend/src/metabase/ui/utils/markMantineFocusSentinels.ts b/frontend/src/metabase/ui/utils/markMantineFocusSentinels.ts
new file mode 100644
index 00000000..362587e2
--- /dev/null
+++ b/frontend/src/metabase/ui/utils/markMantineFocusSentinels.ts
@@ -0,0 +1,126 @@
+/**
+ * Overlay accessibility fixes applied at bootstrap.
+ *
+ * Mantine injects `<div tabindex="-1" data-autofocus>` focus sentinels inside
+ * focus-trapped overlays (menus, modals, popovers). They are purely
+ * presentational but axe flags them as illegal children of `role="menu"`
+ * (aria-required-children), so give them a `separator` role and strip their
+ * tabindex: a non-focusable separator is a valid menu child, while a
+ * focusable one would need slider attributes (aria-required-attr).
+ *
+ * Mantine portals (`<div data-portal="true">` siblings of #root) mount overlay
+ * content outside every landmark, which axe flags under the `region` rule.
+ * Each portal host is promoted to a named `role="complementary"` landmark so
+ * the transient overlay content stays inside a landmark.
+ */
+const SENTINEL_SELECTOR = 'div[data-autofocus="true"]:not([role])';
+const PORTAL_SELECTOR = 'body > div[data-portal="true"]';
+
+function markSentinels(root: ParentNode) {
+  root.querySelectorAll(SENTINEL_SELECTOR).forEach((element) => {
+    element.setAttribute("role", "separator");
+    element.removeAttribute("tabindex");
+  });
+}
+
+let portalCounter = 0;
+
+function markPortalHosts() {
+  document.querySelectorAll(PORTAL_SELECTOR).forEach((element) => {
+    // Empty portal hosts carry no overlay content; leaving them role-less
+    // keeps the landmark list clean and avoids empty named landmarks.
+    if (element.childElementCount === 0) {
+      return;
+    }
+    // Labels must be unique across the page (landmark-unique): a running
+    // counter survives portals being inserted/removed in any order, unlike
+    // a positional index which can repeat after DOM churn.
+    if (!element.hasAttribute("role")) {
+      portalCounter += 1;
+      element.setAttribute("role", "complementary");
+      element.setAttribute("aria-label", `Overlay ${portalCounter}`);
+    }
+  });
+}
+
+const RADIOGROUP_SELECTOR = 'div[role="radiogroup"][aria-labelledby]';
+
+function cleanRadiogroupLabels(root: ParentNode) {
+  // Mantine's InputsGroupFieldset always emits aria-labelledby pointing at
+  // ctx.labelId, even when the Radio.Group has no `label` prop and no label
+  // element is ever rendered (orphan idref — aria-valid-attr-value). Strip
+  // it when the referenced element does not exist.
+  root.querySelectorAll(RADIOGROUP_SELECTOR).forEach((element) => {
+    const labelledBy = element.getAttribute("aria-labelledby");
+    if (
+      labelledBy &&
+      !labelledBy
+        .split(/\s+/)
+        .some((id) => root.querySelector(`#${CSS.escape(id)}`))
+    ) {
+      element.removeAttribute("aria-labelledby");
+    }
+  });
+}
+
+const TAB_SELECTOR = '[role="tab"][aria-controls]';
+
+function cleanTabControls(root: ParentNode) {
+  // Mantine Tabs emit aria-controls={ctx.getPanelId(value)} unconditionally;
+  // tabs rendered without a matching Tabs.Panel (AccountHeader nav, chart
+  // settings sidebars) get an orphan idref — strip it when the target is
+  // absent from the document.
+  root.querySelectorAll(TAB_SELECTOR).forEach((element) => {
+    const controls = element.getAttribute("aria-controls");
+    if (controls && !document.getElementById(controls)) {
+      element.removeAttribute("aria-controls");
+    }
+  });
+}
+
+const TARGET_SELECTOR = '[id$="-target"][aria-haspopup]';
+
+function cleanTargetAria(root: ParentNode) {
+  // Mantine's Popover/Menu Target clones popup aria (target id, aria-haspopup,
+  // aria-expanded) onto the first child regardless of that child's role. When
+  // the cloned target carries no role at all, aria-allowed-attr rejects
+  // aria-expanded — strip the popup attrs on role-less targets.
+  root.querySelectorAll(TARGET_SELECTOR).forEach((element) => {
+    if (!element.getAttribute("role")) {
+      element.removeAttribute("aria-haspopup");
+      element.removeAttribute("aria-expanded");
+    }
+  });
+}
+
+let started = false;
+
+export function markMantineFocusSentinels() {
+  if (started || typeof document === "undefined") {
+    return;
+  }
+  started = true;
+  markSentinels(document.body);
+  markPortalHosts();
+  cleanRadiogroupLabels(document.body);
+  cleanTabControls(document.body);
+  cleanTargetAria(document.body);
+  new MutationObserver((mutations) => {
+    for (const mutation of mutations) {
+      mutation.addedNodes.forEach((node) => {
+        if (!(node instanceof HTMLElement)) {
+          return;
+        }
+        if (node.matches(SENTINEL_SELECTOR)) {
+          node.setAttribute("role", "separator");
+          node.removeAttribute("tabindex");
+        }
+        markSentinels(node);
+      });
+    }
+    markPortalHosts();
+    cleanRadiogroupLabels(document.body);
+    cleanTabControls(document.body);
+    cleanTargetAria(document.body);
+    }).observe(document.body, { childList: true, subtree: true });
+}
