{
 "_comment": "Miroir machine-lisible de la STATES map de tools/audit.mjs (source de vérité = audit.mjs). Ordre = ordre d'exécution. 'deterministic' = l'état rejoue à l'identique sur le seed.",
 "public": { "urls": ["/"], "states": [] },
 "auth": {
  "urls": ["/"],
  "states": [
   { "id": "usage-report-open", "kind": "modal", "target": "#ur", "deterministic": true, "setup": "PUT /rest/config/options {urAccepted:0,urSeen:0} + reload" },
   { "id": "usage-report-dismissed", "kind": "interaction", "deterministic": true, "setup": "déclin #ur (urAccepted=-1) + RESTART syncthing (efface le panneau Restart Needed pour les états suivants)" },
   { "id": "folder-archives-expanded", "kind": "collapse", "target": "#folder-0-N", "deterministic": true },
   { "id": "folder-local-additions", "kind": "modal", "target": "#localChanged", "deterministic": true, "setup": "Lien 'Local Additions' du panneau Archives" },
   { "id": "folder-revert-confirmation", "kind": "modal", "target": "#revert-override-confirmation", "deterministic": true },
   { "id": "folder-restore-versions", "kind": "modal", "target": "#restoreVersions", "deterministic": true, "setup": "fancytree peuplé depuis .stversions" },
   { "id": "folder-restore-confirm", "kind": "modal", "target": "#restore-versions-confirmation", "deterministic": true, "setup": "coche .fancytree-checkbox puis Restore Selected" },
   { "id": "folder-main-expanded", "kind": "collapse", "deterministic": true },
   { "id": "folder-broken-expanded", "kind": "collapse", "deterministic": true, "note": "panneau erreur (folder failed) rendu" },
   { "id": "edit-folder-general", "kind": "modal+tab", "target": "#edit-folder #folder-general", "deterministic": true },
   { "id": "edit-folder-sharing", "kind": "tab", "target": "#folder-sharing", "deterministic": true },
   { "id": "edit-folder-versioning", "kind": "tab", "target": "#folder-versioning", "deterministic": true },
   { "id": "edit-folder-ignores", "kind": "tab", "target": "#folder-ignores", "deterministic": true },
   { "id": "edit-folder-advanced", "kind": "tab", "target": "#folder-advanced", "deterministic": true },
   { "id": "add-folder", "kind": "modal", "target": "#edit-folder (add)", "deterministic": true },
   { "id": "remove-folder-confirm", "kind": "modal", "target": "#remove-folder-confirmation", "deterministic": true },
   { "id": "device-bob-expanded", "kind": "collapse", "deterministic": true },
   { "id": "device-alice-expanded", "kind": "collapse", "deterministic": true },
   { "id": "edit-device-general", "kind": "modal+tab", "target": "#edit-device #device-general", "deterministic": true },
   { "id": "edit-device-sharing", "kind": "tab", "target": "#device-sharing", "deterministic": true },
   { "id": "edit-device-advanced", "kind": "tab", "target": "#device-advanced", "deterministic": true },
   { "id": "add-device", "kind": "modal", "target": "#edit-device (add)", "deterministic": true },
   { "id": "remove-device-confirm", "kind": "modal", "target": "#remove-device-confirmation", "deterministic": true },
   { "id": "share-device-id", "kind": "modal", "target": "#share-device-id-dialog", "deterministic": true },
   { "id": "show-id-qr", "kind": "modal", "target": "#idqr", "deterministic": true },
   { "id": "log-viewer", "kind": "modal", "target": "#logViewer", "deterministic": true },
   { "id": "recent-changes", "kind": "modal", "target": "#recentChanges", "deterministic": true },
   { "id": "settings-general", "kind": "modal+tab", "target": "#settings #settings-general", "deterministic": true },
   { "id": "settings-gui", "kind": "tab", "target": "#settings-gui", "deterministic": true },
   { "id": "settings-connections", "kind": "tab", "target": "#settings-connections", "deterministic": true },
   { "id": "settings-ignored-devices", "kind": "tab", "target": "#ignored-devices", "deterministic": true, "setup": "remoteIgnoredDevices seedé" },
   { "id": "settings-ignored-folders", "kind": "tab", "target": "#ignored-folders", "deterministic": true, "setup": "devices[].ignoredFolders seedé" },
   { "id": "settings-ur-preview", "kind": "modal", "target": "#urPreview", "deterministic": true, "setup": "depuis Settings → Preview (preview-key JSON mock par l'app)" },
   { "id": "settings-discard", "kind": "interaction", "deterministic": true, "setup": "modif champ + Discard (cas dirty du résumé de changes)" },
   { "id": "advanced-settings", "kind": "modal", "target": "#advanced", "deterministic": true, "note": "accordion de toutes les sections avancées" },
   { "id": "advanced-folder-section", "kind": "modal+accordion", "deterministic": true },
   { "id": "about", "kind": "modal", "target": "#about", "deterministic": true },
   { "id": "about-includes", "kind": "modal", "deterministic": true, "note": "longueur de la liste Third Party" },
   { "id": "connectivity-listeners", "kind": "modal", "target": "#listeners", "deterministic": true, "setup": "endpoint Failed → badge Error rendu" },
   { "id": "connectivity-discovery", "kind": "modal", "target": "#discovery", "deterministic": true },
   { "id": "help-menu-open", "kind": "dropdown", "deterministic": true },
   { "id": "actions-menu-open", "kind": "dropdown", "deterministic": true },
   { "id": "lang-menu-open", "kind": "dropdown", "deterministic": true },
   { "id": "theme-dark", "kind": "theme", "deterministic": true, "setup": "PUT config/gui theme=dark + RESTART + attente body bg rgb(39,39,39)" },
   { "id": "settings-dark", "kind": "modal+theme", "target": "#settings", "deterministic": true, "setup": "ensureDark (idempotent) + modale Settings" },
   { "id": "edit-device-dark", "kind": "modal+theme", "target": "#editDevice", "deterministic": true, "setup": "ensureDark + modale editDevice desktop-bob" },
   { "id": "edit-folder-sharing-dark", "kind": "modal+theme", "target": "#editFolder", "deterministic": true, "setup": "ensureDark + onglet Sharing (arbre fancytree)" },
   { "id": "advanced-dark", "kind": "modal+theme", "target": "#advanced", "deterministic": true, "setup": "ensureDark + accordéon options" },
   { "id": "actions-menu-dark", "kind": "dropdown+theme", "deterministic": true, "setup": "ensureDark + dropdown Actions ouvert" },
   { "id": "mobile-home", "kind": "viewport", "deterministic": true, "setup": "theme=light + RESTART + viewport 390x844 (navbar xs ; light explicite car default suit prefers-color-scheme)" }
  ],
  "excluded": [
   "Actions → Restart / Shut Down (actions immédiates sans modale — tueraient le serveur)",
   "#networkError / #httpError / #restarting / #upgrading / #savingChanges (transitoires, non jouables)",
   "#needed / #remoteNeed / #failed (exigent un distant en ligne rapportant des besoins)",
   "#majorUpgrade / #upgrade (exigent upgradeInfo.newer : build versionné + réseau releases)",
   "folder receive-encrypted + chiffrés locaux (pair requis)",
   "#revert-override-confirmation variante 'override' (sendonly outofsync, pair requis)",
   "editShareTemplate.html (template imbriqué non jouable directement)"
  ]
 }
}
