index d4db975..17ef731 100644
--- a/gui/default/assets/css/overrides.css
+++ b/gui/default/assets/css/overrides.css
@@ -565,4 +565,49 @@ html[lang|="ko"] i {
 .select-on-click {
     -webkit-user-select: all;
     user-select: all;
-}
\ No newline at end of file
+}
+/*
+ * Accessibility: heading semantics and small-target spacing.
+ */
+h1.navbar-brand {
+    margin-top: 0;
+    margin-bottom: 0;
+}
+/* Adjacent footer buttons (pending device/folder panels) need spacing so
+   their 24px target circles do not overlap. */
+.panel-footer .btn + .btn {
+    margin-left: 8px;
+}
+
+/* -- correction a11y : contraste des liens actifs de menu déroulant
+   (Bootstrap #337ab7 sur texte blanc = 4,4:1 < 4,5:1). -- */
+.dropdown-menu > .active > a,
+.pagination > .active > a,
+.dropdown-menu > .active > a:hover,
+.dropdown-menu > .active > a:focus,
+.pagination > .active > a:hover,
+.pagination > .active > a:focus {
+  background-color: #1d6fa5;
+}
+/* -- correction a11y : .text-warning Bootstrap = 4,0:1 sur blanc. -- */
+.text-warning, .text-warning:hover { color: #745e1e; }
+/* -- correction a11y : liens dans du texte doivent se distinguer par
+   autre chose que la couleur (WCAG 1.4.1) → soulignement. -- */
+.modal-body p > a:not(.btn),
+.modal-body .small > a:not(.btn),
+.modal-body ul:not(.dropdown-menu) li > a:not(.btn) {
+  text-decoration: underline;
+}
+
+/* -- correction a11y : couleur de lien Flatly #3498db = 3,15:1 sur
+   blanc — insuffisant (WCAG 1.4.3, 4,5:1). #1d6fa5 = 5,43:1. -- */
+a, .text-primary, .pagination > li > a {
+  color: #1d6fa5;
+}
+a:hover, a:focus {
+  color: #14557e;
+}
+/* -- correction a11y : badge Bootstrap blanc sur #777777 = 4,48:1. -- */
+.badge {
+  background-color: #6d6d6d;
+}
