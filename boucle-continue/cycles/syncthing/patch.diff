     $httpProvider.defaults.xsrfCookieName = 'CSRF-Token-' + metadata.deviceIDShort;
 });
 
+syncthing.run(function () {
+    // Bootstrap 3.4 collapse sets aria-expanded on the toggled element
+    // itself, where the attribute is not allowed — it belongs on the
+    // control only. Remove it once each expand/collapse transition settles.
+    $(document).on('show.bs.collapse shown.bs.collapse hide.bs.collapse hidden.bs.collapse', function (event) {
+        $(event.target).removeAttr('aria-expanded');
+    });
+
+    // The fixed-top navbar lets open dropdown menus overlap the page
+    // controls below it. While a nav menu is open, push the content down
+    // so nothing interactive is covered.
+    $(document).on('shown.bs.dropdown', '.navbar-nav li', function () {
+        var menu = this.querySelector('ul.dropdown-menu');
+        var content = document.querySelector('.container.content');
+        if (menu && content) {
+            var need = menu.getBoundingClientRect().bottom - content.getBoundingClientRect().top;
+            if (need > 0) {
+                content.style.marginTop = need + 'px';
+            }
+        }
+    }).on('hidden.bs.dropdown', '.navbar-nav li', function () {
+        var content = document.querySelector('.container.content');
+        if (content) {
+            content.style.marginTop = '';
+        }
+    });
+});
+
