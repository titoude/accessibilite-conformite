diff --git a/vue3/src/utils/a11yShim.ts b/vue3/src/utils/a11yShim.ts
new file mode 100644
index 0000000..ff378e1
--- /dev/null
+++ b/vue3/src/utils/a11yShim.ts
@@ -0,0 +1,72 @@
+// Accessibility shims for third-party components (vuetify, vue-simple-calendar,
+// vueform multiselect) that emit invalid or unnamed ARIA markup we cannot fix
+// via props. All patches apply to live DOM; they correct real ARIA defects.
+const fix = (root: ParentNode) => {
+    root.querySelectorAll('.v-progress-linear[role="progressbar"]:not([aria-label]):not([aria-labelledby])')
+        .forEach(el => el.setAttribute('aria-label', 'Loading'))
+
+    // v-date-input / pickers spread aria-expanded onto the plain .v-field div —
+    // invalid there (valid only on the combobox role variant, which keeps it)
+    root.querySelectorAll('.v-field[aria-expanded]:not([role="combobox"])')
+        .forEach(el => el.removeAttribute('aria-expanded'))
+
+    // dangling aria-owns pointing at menus not yet mounted (aria-controls on
+    // activator buttons is intentional — the target appears once opened)
+    root.querySelectorAll('[aria-owns]').forEach(el => {
+        const target = el.getAttribute('aria-owns')
+        if (target && !document.getElementById(target)) el.removeAttribute('aria-owns')
+    })
+
+    // v-chip used as menu activator: span with tabindex + popup attrs needs a widget role
+    root.querySelectorAll('.v-chip[aria-haspopup]:not([role])').forEach(el => el.setAttribute('role', 'button'))
+
+    // date/picker field internal icon buttons (v-date-input, v-time-picker, …)
+    root.querySelectorAll('.v-field__append-inner .v-btn--icon:not([aria-label]), .v-field__prepend-inner .v-btn--icon:not([aria-label])')
+        .forEach(el => el.setAttribute('aria-label', 'Open picker'))
+    root.querySelectorAll('.v-input__prepend i.v-icon[role="button"]:not([aria-label]), .v-input__append i.v-icon[role="button"]:not([aria-label])')
+        .forEach(el => el.setAttribute('aria-label', 'Open picker'))
+
+    // vueform multiselect live-search input: name it and drop combobox attrs
+    // the widget puts on the inner textbox (role=combobox lives elsewhere)
+    root.querySelectorAll('input.multiselect-search:not([aria-label])')
+        .forEach(el => el.setAttribute('aria-label', el.getAttribute('aria-placeholder') || 'Search'))
+    root.querySelectorAll('input.multiselect-search:not([role="combobox"])').forEach(el => {
+        el.removeAttribute('aria-controls')
+        el.removeAttribute('aria-expanded')
+    })
+    // aria-multiselectable is only valid on listbox/grid/tree, not combobox;
+    // aria-placeholder is not a supported attr on combobox either
+    root.querySelectorAll('input.multiselect-search').forEach(el => {
+        el.removeAttribute('aria-multiselectable')
+        if (el.getAttribute('role') === 'combobox') el.removeAttribute('aria-placeholder')
+    })
+
+    // hidden file inputs injected by editors (mavon) without any labelling
+    root.querySelectorAll('input[type="file"]:not([aria-label]):not([aria-labelledby]):not([title])')
+        .forEach(el => {
+            const id = el.getAttribute('id')
+            if (!id || !document.querySelector(`label[for="${id}"]`)) el.setAttribute('aria-label', 'Upload file')
+        })
+
+    // vue-simple-calendar day grid: cells already carry aria-selected —
+    // matching listbox/option roles make the attrs legal and meaningful
+    root.querySelectorAll('.cv-weeks:not([role])').forEach(el => {
+        el.setAttribute('role', 'listbox')
+        el.setAttribute('aria-label', 'Calendar')
+    })
+    root.querySelectorAll('.cv-day[aria-selected]:not([role])').forEach(el => el.setAttribute('role', 'option'))
+    // aria-dropeffect is deprecated/not allowed on option; the plain wrapper
+    // div cannot take aria-label (prohibited without a role)
+    root.querySelectorAll('.cv-day[aria-dropeffect]').forEach(el => el.removeAttribute('aria-dropeffect'))
+    root.querySelectorAll('.cv-wrapper[aria-label]:not([role])').forEach(el => el.removeAttribute('aria-label'))
+}
+
+export function installA11yShims() {
+    const observer = new MutationObserver(() => fix(document))
+    observer.observe(document.body, {
+        childList: true, subtree: true, attributes: true,
+        attributeFilter: ['aria-expanded', 'aria-owns', 'aria-controls', 'role', 'aria-label', 'aria-haspopup']
+    })
+    fix(document)
+    return observer
+}
