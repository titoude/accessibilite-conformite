diff --git a/cookbook/templates/frontend/tandoor.html b/cookbook/templates/frontend/tandoor.html
index 4f37462..5bb6ac0 100644
--- a/cookbook/templates/frontend/tandoor.html
+++ b/cookbook/templates/frontend/tandoor.html
@@ -46,6 +46,41 @@
                 background: #212121 !important;
             }
         {% endif %}
+
+        /* Accessibilite : contrastes AA — vuetify estompe le texte secondaire via
+           opacity (var --v-medium-emphasis) ; il faut un color plein + opacity:1.
+           Les overlays vuetify sont teleportes hors de .v-application : regles
+           non prefixees. Les classes utilitaires vuetify portent elles-memes
+           !important et sont injectees apres ce bloc : la specifite est doublee
+           (.x.x) pour gagner quel que soit l'ordre de chargement. */
+        .v-list-item-subtitle.v-list-item-subtitle,
+        .v-card-subtitle.v-card-subtitle,
+        .v-field .v-label.v-field-label.v-field-label,
+        label.v-label.v-label,
+        .v-messages__message.v-messages__message,
+        .v-data-table-header__content.v-data-table-header__content,
+        .v-data-table-header__content.v-data-table-header__content span,
+        .v-data-table__th.v-data-table__th span,
+        .text-wrap.text-wrap,
+        .text-disabled.text-disabled {
+            color: #595959 !important;
+            opacity: 1 !important;
+        }
+        .cv-weeknumber > span { color: #595959 !important; }
+        .multiselect-placeholder.multiselect-placeholder { color: #5b5b5b !important; opacity: 1 !important; }
+        /* avatar "initiale" : blanc sur primary #b98766 = 3.12:1 — teinte assombrie */
+        .v-avatar.bg-primary { background-color: #9a6a48 !important; }
+        /* l'estompage se fait aussi sur les conteneurs (opacity composée) */
+        .v-messages.v-messages,
+        .v-input__details.v-input__details,
+        .v-data-table-header__content.v-data-table-header__content,
+        .v-list-item--variant-text.v-list-item--variant-text {
+            opacity: 1 !important;
+        }
+        .v-list-item--variant-text .v-list-item-subtitle,
+        .v-messages__message.v-messages__message {
+            color: #595959 !important;
+        }
     </style>
 
 </head>
