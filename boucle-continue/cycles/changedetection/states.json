{
  "_comment": "Miroir machine-lisible de la STATES map de tools/audit.mjs (source de vérité = audit.mjs). Ordre = ordre d'exécution. 'deterministic' = l'état rejoue à l'identique sur le seed.",
  "public": {
    "urls": [
      "/login"
    ],
    "states": []
  },
  "auth": {
    "urls": [
      "/",
      "/tags/list",
      "/tags/edit/$CD_TAG_UUID",
      "/queue",
      "/settings",
      "/settings/notification-logs",
      "/backups/",
      "/imports/import",
      "/diff/$CD_API_DOCS_UUID",
      "/diff/$CD_API_DOCS_UUID/extract",
      "/edit/$CD_API_DOCS_UUID",
      "/edit/$CD_RATES_UUID",
      "/preview/$CD_API_DOCS_UUID",
      "/add-watch-ui/",
      "/clear_history"
    ],
    "states": [
      {
        "id": "search-modal-open",
        "kind": "dialog",
        "target": "#search-modal",
        "deterministic": true,
        "setup": "clic .js-open-search-modal (sidebar)"
      },
      {
        "id": "language-modal-open",
        "kind": "dialog",
        "target": "#language-modal",
        "deterministic": true,
        "setup": "clic #menu-ui-language a.language-selector"
      },
      {
        "id": "llm-not-configured-modal-open",
        "kind": "dialog",
        "target": "#llm-not-configured-modal",
        "deterministic": true,
        "setup": "clic .toggle-ai-mode (LLM non configuré → modale info)"
      },
      {
        "id": "heart-overlay-open",
        "kind": "offcanvas",
        "target": "#overlay.visible",
        "deterministic": true,
        "setup": "clic #heart-us (drawer 'support us')"
      },
      {
        "id": "watchlist-checked",
        "kind": "interaction",
        "target": "#checkbox-operations",
        "deterministic": true,
        "setup": "check 1re checkbox de watch → barre bulk ops"
      },
      {
        "id": "bulk-browser-modal-open",
        "kind": "dialog",
        "target": "dialog.modal-dialog[open]",
        "deterministic": true,
        "setup": "watchlist-checked + clic #checkbox-set-browser"
      },
      {
        "id": "bulk-proxy-modal-open",
