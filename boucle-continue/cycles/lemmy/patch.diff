diff --git a/src/assets/css/main.css b/src/assets/css/main.css
index 870f689..d037417 100644
--- a/src/assets/css/main.css
+++ b/src/assets/css/main.css
@@ -485,3 +485,54 @@ br.big {
 .totp-link {
   width: fit-content;
 }
+
+/* a11y fixes (WCAG 2.2 AA): contrast, target size, non-color link cues */
+
+/* 1.4.3: faint secondary text & icon labels -> AA gray */
+.fst-italic,
+.sort-select-icon {
+  color: #495057 !important;
+}
+
+/* 2.5.8: small standalone controls get a 24px hit area */
+.sort-select-icon,
+a[title="RSS"] {
+  min-width: 24px !important;
+  min-height: 24px !important;
+  display: inline-flex !important;
+  align-items: center !important;
+  justify-content: center !important;
+}
+
+.person-listing,
+.community-link,
+.fst-italic {
+  display: inline-block !important;
+  padding-top: 5px !important;
+  padding-bottom: 5px !important;
+}
+
+/* 1.4.1: links inside running text get a non-color cue */
+.md-div a,
+.card-text a,
+.person-listing,
+.community-link,
+.overflow-wrap-anywhere,
+.fst-italic {
+  text-decoration: underline !important;
+}
+
+/* 2.5.8: compact action & markdown toolbar buttons -> 24px */
+.btn-animate,
+button.btn-link[data-tippy-content],
+a[title="formatting help"],
+.rounded.bg-light.border > .d-flex.border-bottom .btn {
+  min-width: 24px !important;
+  min-height: 24px !important;
+}
+
+/* 2.5.8: action dropdowns flow inline instead of covering nearby targets */
+ul.dropdown-menu[id^="post-actions-dropdown"],
+ul.dropdown-menu[id^="comment-actions-dropdown"] {
+  position: static !important;
+}
