@@ -49,16 +49,33 @@ window.tooltipSetup = () => {
     const tooltipText = element.getAttribute('title');
     element.removeAttribute('title');
     element.setAttribute('data-title', tooltipText);
+    if (!element.getAttribute('aria-label') && !element.getAttribute('aria-labelledby') && !element.textContent.trim()) {
+      element.setAttribute('aria-label', tooltipText);
+    } else {
+      // L'attribut title fournissait la description accessible ; la
+      // conserver via aria-description maintenant qu'il est retiré.
+      element.setAttribute('aria-description', tooltipText);
+    }
     const customTooltip = document.createElement('div');
     customTooltip.className = 'btn-tooltip';
+    customTooltip.setAttribute('role', 'tooltip');
+    customTooltip.setAttribute('aria-hidden', 'true');
     customTooltip.textContent = tooltipText;
 
