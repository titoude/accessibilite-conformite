-      customTooltip.style.top = `${event.pageY + 10}px`;
+      customTooltip.style.left = `${x + 10}px`; // Position tooltip slightly away from the cursor
+      customTooltip.style.top = `${y + 10}px`;
+    };
+    const hideTooltip = () => {
+      customTooltip.style.display = 'none';
+      customTooltip.setAttribute('aria-hidden', 'true');
+    };
+
+    element.addEventListener('mouseenter', (event) => {
+      showTooltip(event.pageX, event.pageY);
     });
 
     // Update the position of the tooltip as the user moves the mouse
@@ -68,8 +85,23 @@ window.tooltipSetup = () => {
     });
 
     // Hide the tooltip when the mouse leaves
-    element.addEventListener('mouseleave', () => {
-      customTooltip.style.display = 'none';
+    element.addEventListener('mouseleave', hideTooltip);
+
+    // Same tooltip on keyboard focus, dismissed on blur or Escape. Quand
+    // l'élément n'est pas focusable (icône <div> dans un lien), le focus
+    // se fait sur l'ancêtre interactif le plus proche.
+    const focusTarget = element.tabIndex >= 0
+      ? element
+      : element.closest('a, button, input, select, textarea, [tabindex]') || element;
+    focusTarget.addEventListener('focus', () => {
+      const rect = element.getBoundingClientRect();
+      showTooltip(rect.left + window.scrollX, rect.bottom + window.scrollY);
+    });
+    focusTarget.addEventListener('blur', hideTooltip);
+    focusTarget.addEventListener('keydown', (event) => {
+      if (event.key === 'Escape') {
+        hideTooltip();
+      }
     });
   });
 };
