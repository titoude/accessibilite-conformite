diff --git a/src/main/resources/static/css/a11y.css b/src/main/resources/static/css/a11y.css
new file mode 100644
index 000000000..717a97649
--- /dev/null
+++ b/src/main/resources/static/css/a11y.css
@@ -0,0 +1,84 @@
+/* Overrides d'accessibilite (WCAG 2.2 AA) — charges en dernier via fragments/common :: head */
+
+/* Liens : #0d6efd atteignait 3.2:1 sur #cddceb et 3.9:1 sur #edf0f5 */
+a {
+  color: #0a58ca;
+}
+
+a:hover,
+a:focus {
+  color: #084298;
+}
+
+/* Badge "Go Pro" : texte blanc sur #007bff = 3.97:1 */
+.go-pro-badge {
+  background-color: #0056b3;
+}
+
+.go-pro-link:hover .go-pro-badge,
+.go-pro-link:focus .go-pro-badge {
+  background-color: #003d80;
+}
+
+/* Lien "powered by" du footer : heritait un gris a 1.09:1 */
+.stirling-link {
+  color: #343a40;
+  text-decoration: underline;
+}
+
+.stirling-link:hover {
+  color: #0a58ca;
+}
+
+/* Liens du footer : cible de pointage >= 24px (WCAG 2.5.8) */
+.footer-link {
+  display: inline-block;
+  padding: 0.4rem 0.75rem;
+}
+
+/* Bouton submit des pages outil : mesure #c4cfd9 sur #2678be = 2.94:1 */
+#submitBtn.btn-primary {
+  background-color: #0056b3;
+  border-color: #0056b3;
+}
+
+#submitBtn.btn-primary:hover,
+#submitBtn.btn-primary:focus {
+  background-color: #00428a;
+  border-color: #00428a;
+}
+
+/* h1 issu de .tool-header : conserve le rendu visuel d'origine */
+h1.tool-header {
+  margin: 0 0 2rem;
+  font-size: inherit;
+  font-weight: inherit;
+  line-height: 1.4;
+}
+
+/* Titres de section de la home (h6 -> h2) : rendu conserve */
+h2.menu-title {
+  margin: 0.67em 0;
+  font-size: 0.67em;
+  font-weight: 700;
+}
+
+/* Liens footer : #0a58ca ne suffit pas sur #d4d4d7 (4.35:1) */
+body .footer-link {
+  color: #084298;
+}
+
+body .footer-link:hover,
+body .footer-link:focus {
+  color: #0a58ca;
+}
+
+/* navbar.css est recharge APRES a11y.css sur view-pdf : specifier */
+body .go-pro-badge {
+  background-color: #0056b3;
+}
+
+body .go-pro-link:hover .go-pro-badge,
+body .go-pro-link:focus .go-pro-badge {
+  background-color: #003d80;
+}
