@@ -62,3 +62,57 @@ th {
     right: 0.35rem;
   }
 }
+
+// WCAG 2.5.8 — ensure the password visibility toggle has a >=24px target.
+.ant-input-password-icon {
+  min-width: 24px;
+  min-height: 24px;
+}
+
+// WCAG 1.4.3 — antd's default description color (rgba(0,0,0,.45)) only reaches
+// 3.5:1 on light surfaces; the antd-default-theme.json token covers runtime,
+// this guards the pre-extracted stylesheet before hydration.
+.ant-card-meta-description,
+.ant-statistic-content-suffix,
+.ant-collapse-content {
+  color: #5c5f6b;
+}
+
+// WCAG 1.4.1 — links inside running text must be distinguishable without color.
+p a,
+li a,
+article a,
+.hash-link,
+.ant-card-meta-description a,
+.ant-empty-description a {
+  text-decoration: underline;
+}
+
+// WCAG 1.4.3 — CodeMirror placeholder text defaults to ~2.9:1.
+.cm-placeholder {
+  color: #5c5f6b;
+}
+
+// WCAG 2.5.8 — admin sider menu links fill the whole item row.
+.ant-menu-title-content a {
+  display: block;
+}
+
+// WCAG 1.4.3 — the switch's inner ON/OFF glyph on the grey track needs
+// pure white to reach 4.5:1 against the #737373 unchecked color.
+.ant-switch-inner {
+  color: #fff;
+}
+
+// CodeMirror placeholder on the editor's light gutter/line background.
+.cm-content .cm-placeholder,
+.cm-placeholder {
+  color: #575c63;
+}
+
+// Modal body copy and the table header filter trigger icon on light surfaces.
+.ant-modal-body > p,
+.ant-table .ant-dropdown-trigger,
+.ant-table-filter-trigger {
+  color: #575c63;
+}
