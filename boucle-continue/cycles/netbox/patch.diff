diff --git a/netbox/project-static/styles/_variables.scss b/netbox/project-static/styles/_variables.scss
index a04f5db8..11b9b985 100644
--- a/netbox/project-static/styles/_variables.scss
+++ b/netbox/project-static/styles/_variables.scss
@@ -35,3 +35,22 @@ $primary: $dark-teal;
 
 // Navbar active dropdown border color
 $navbar-active-border-color: $dark-teal;
+
+// Palette AA — couleurs pleines avec texte blanc >= 4.5:1 (WCAG 1.4.3).
+// Les défauts Tabler échouent (btn-primary ~4.0, btn-yellow ~1.9, btn-green ~2.5) :
+// chaque teinte est assombrie vers son équivalent 700, famille conservée.
+$primary:   #007169;
+$dark-teal: #007169; // #00857D = ~3.8:1 sur le dégradé sidebar (1.4.3)
+$secondary: #525d6b;
+$blue:      #0a5fc0;
+$azure:     #1865b8;
+$indigo:    #3a56d4;
+$purple:    #a235bb;
+$pink:      #c22e60;
+$red:       #b02a2a;
+$orange:    #b54708;
+$yellow:    #7a5c00;
+$lime:      #4a750a;
+$green:     #1f7034;
+$teal:      #067057;
+$cyan:      #0d6e7f;
diff --git a/netbox/project-static/styles/custom/_a11y.scss b/netbox/project-static/styles/custom/_a11y.scss
new file mode 100644
index 00000000..14754b0e
--- /dev/null
+++ b/netbox/project-static/styles/custom/_a11y.scss
@@ -0,0 +1,51 @@
+// Accessibilité WCAG 2.x — correctifs du banc (cycle 52).
+// La palette AA vit dans styles/_variables.scss (avant import Tabler).
+
+// 1) Cibles tactiles : les liens très compacts (badges dans les cellules de
+//    table, icône "clear ordering" des en-têtes triables) descendent sous les
+//    24x24 px requis par WCAG 2.5.8 (AA). On élargit la zone cliquable sans
+//    changer le rendu visuel (padding transparent).
+.table .badge > a,
+.table th a.text-danger,
+.badge > a {
+  display: inline-block;
+  min-width: 24px;
+  min-height: 24px;
+  padding: 0.125rem 0.25rem;
+}
+
+// 2) Liens au fil du texte : WCAG 1.4.1 exige une distinction non colorimétrique
+//    quand le contraste du lien vs texte environnant < 3:1 — soulignement dans
+//    les cellules d'attributs (valeurs linkifiées des panels).
+.card td > span > a:not(.btn),
+.card td div span > a:not(.btn),
+.table td > span > a:not(.btn):not(.badge),
+.attr-table td span > a:not(.btn) {
+  text-decoration: underline;
+}
+
+// 3) Éléments désactivés : color-mix(40%) échoue partout — repli sur --tblr-muted.
+.dropdown-item.disabled,
+.dropdown-item:disabled {
+  color: var(--tblr-muted);
+}
+
+// 4) Thème sombre : --tblr-muted (gris-500) échoue sur fonds sombres
+//    (pied de page #081b2a ≈ 3.6:1). Basculer sur un gris plus clair.
+[data-bs-theme=dark],
+body[data-bs-theme=dark] {
+  --tblr-muted: #9ca3af;
+}
+
+// 5) Pied de page : le bandeau est sombre dans les deux thèmes (#081b2a) —
+//    --tblr-muted n'y atteint jamais 4.5:1. Texte clair dédié.
+#footer-stamp .list-inline-item,
+footer .list-inline-item {
+  color: #525d6b;
+}
+
+[data-bs-theme=dark] #footer-stamp .list-inline-item,
+[data-bs-theme=dark] footer .list-inline-item,
+body[data-bs-theme=dark] #footer-stamp .list-inline-item {
+  color: #a3aebf;
+}
