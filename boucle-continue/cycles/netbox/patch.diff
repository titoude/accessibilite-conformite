-        return dark
-    return light
+    bg_lum = _relative_luminance(bg_color)
+    dark_ratio = _contrast_ratio(bg_lum, _relative_luminance(dark))
+    light_ratio = _contrast_ratio(bg_lum, _relative_luminance(light))
+    return dark if dark_ratio >= light_ratio else light
 
 
