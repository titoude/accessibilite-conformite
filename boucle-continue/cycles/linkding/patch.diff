diff --git a/bookmarks/templates/rest_framework/horizontal/radio.html b/bookmarks/templates/rest_framework/horizontal/radio.html
new file mode 100644
index 0000000..25f77c5
--- /dev/null
+++ b/bookmarks/templates/rest_framework/horizontal/radio.html
@@ -0,0 +1,57 @@
+{% load i18n %}
+{% load rest_framework %}
+
+{% trans "None" as none_choice %}
+
+<div class="form-group">
+  {% if field.label %}
+    <label class="col-sm-2 control-label {% if style.hide_label %}sr-only{% endif %}" for="id_{{ field.name }}">
+      {{ field.label }}
+    </label>
+  {% endif %}
+
+  <div class="col-sm-10">
+    {% if style.inline %}
+      {% if field.allow_null or field.allow_blank %}
+        <label class="radio-inline">
+          <input id="id_{{ field.name }}" type="radio" name="{{ field.name }}" value="" {% if not field.value %}checked{% endif %} />
+          {{ none_choice }}
+        </label>
+      {% endif %}
+
+      {% for key, text in field.choices|items %}
+        <label class="radio-inline">
+          <input id="id_{{ field.name }}{% if field.allow_null or field.allow_blank %}_{{ forloop.counter }}{% else %}{% if forloop.counter != 1 %}_{{ forloop.counter }}{% endif %}{% endif %}" type="radio" name="{{ field.name }}" value="{{ key }}" {% if key|as_string == field.value|as_string %}checked{% endif %} />
+          {{ text }}
+        </label>
+      {% endfor %}
+    {% else %}
+      {% if field.allow_null or field.allow_blank %}
+        <div class="radio">
+          <label>
+            <input id="id_{{ field.name }}" type="radio" name="{{ field.name }}" value="" {% if not field.value %}checked{% endif %} />
+            {{ none_choice }}
+          </label>
+        </div>
+      {% endif %}
+        {% for key, text in field.choices|items %}
+          <div class="radio">
+            <label>
+              <input id="id_{{ field.name }}{% if field.allow_null or field.allow_blank %}_{{ forloop.counter }}{% else %}{% if forloop.counter != 1 %}_{{ forloop.counter }}{% endif %}{% endif %}" type="radio" name="{{ field.name }}" value="{{ key }}" {% if key|as_string == field.value|as_string %}checked{% endif %} />
+              {{ text }}
+            </label>
+          </div>
+        {% endfor %}
+    {% endif %}
+
+    {% if field.errors %}
+      {% for error in field.errors %}
+        <span class="help-block">{{ error }}</span>
+      {% endfor %}
+    {% endif %}
+
+    {% if field.help_text %}
+      <span class="help-block">{{ field.help_text|safe }}</span>
+    {% endif %}
+  </div>
+</div>
diff --git a/bookmarks/templates/rest_framework/horizontal/select.html b/bookmarks/templates/rest_framework/horizontal/select.html
new file mode 100644
index 0000000..92a8fbd
--- /dev/null
+++ b/bookmarks/templates/rest_framework/horizontal/select.html
@@ -0,0 +1,36 @@
+{% load rest_framework %}
+
+<div class="form-group">
+  {% if field.label %}
+    <label class="col-sm-2 control-label {% if style.hide_label %}sr-only{% endif %}" for="id_{{ field.name }}">
+      {{ field.label }}
+    </label>
+  {% endif %}
+
+  <div class="col-sm-10">
+    <select class="form-control" id="id_{{ field.name }}" name="{{ field.name }}">
+      {% if field.allow_null or field.allow_blank %}
+        <option value="" {% if not field.value %}selected{% endif %}>--------</option>
+      {% endif %}
+      {% for select in field.iter_options %}
+          {% if select.start_option_group %}
+            <optgroup label="{{ select.label }}">
+          {% elif select.end_option_group %}
+            </optgroup>
+          {% else %}
+            <option value="{{ select.value }}" {% if select.value|as_string == field.value|as_string %}selected{% endif %} {% if select.disabled %}disabled{% endif %}>{{ select.display_text }}</option>
+          {% endif %}
+      {% endfor %}
+    </select>
+
+    {% if field.errors %}
+      {% for error in field.errors %}
+        <span class="help-block">{{ error }}</span>
+      {% endfor %}
+    {% endif %}
+
+    {% if field.help_text %}
+      <span class="help-block">{{ field.help_text|safe }}</span>
+    {% endif %}
+  </div>
+</div>
diff --git a/bookmarks/templates/rest_framework/horizontal/select_multiple.html b/bookmarks/templates/rest_framework/horizontal/select_multiple.html
new file mode 100644
index 0000000..0475896
--- /dev/null
+++ b/bookmarks/templates/rest_framework/horizontal/select_multiple.html
@@ -0,0 +1,38 @@
+{% load i18n %}
+{% load rest_framework %}
+
+{% trans "No items to select." as no_items %}
+
+<div class="form-group">
+  {% if field.label %}
+    <label class="col-sm-2 control-label {% if style.hide_label %}sr-only{% endif %}" for="id_{{ field.name }}">
+      {{ field.label }}
+    </label>
+  {% endif %}
+
+  <div class="col-sm-10">
+    <select multiple class="form-control" id="id_{{ field.name }}" name="{{ field.name }}">
+      {% for select in field.iter_options %}
+        {% if select.start_option_group %}
+          <optgroup label="{{ select.label }}">
+        {% elif select.end_option_group %}
+          </optgroup>
+        {% else %}
+          <option value="{{ select.value }}" {% if select.value|as_string in field.value|as_list_of_strings %}selected{% endif %} {% if select.disabled %}disabled{% endif %}>{{ select.display_text }}</option>
+        {% endif %}
