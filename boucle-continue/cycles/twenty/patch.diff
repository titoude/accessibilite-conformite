diff --git a/packages/twenty-front/src/modules/ui/utilities/drag-and-drop/utils/neutralizeDragActivatorSemantics.ts b/packages/twenty-front/src/modules/ui/utilities/drag-and-drop/utils/neutralizeDragActivatorSemantics.ts
new file mode 100644
index 0000000000..93ac66aab8
--- /dev/null
+++ b/packages/twenty-front/src/modules/ui/utilities/drag-and-drop/utils/neutralizeDragActivatorSemantics.ts
@@ -0,0 +1,38 @@
+import { DND_KIT_ACCESSIBILITY_ATTRIBUTES } from '@/ui/utilities/drag-and-drop/constants/DndKitAccessibilityAttributes';
+
+const suppressorsByElement = new WeakMap<Element, MutationObserver>();
+
+const NEUTRALIZED_ATTRIBUTES = [
+  ...DND_KIT_ACCESSIBILITY_ATTRIBUTES,
+  'aria-label',
+];
+
+const INTERACTIVE_DESCENDANT_SELECTOR =
+  'button, a[href], input, select, textarea, summary, [tabindex], [role]';
+
+// A drag surface that already wraps a real control (a column header holding
+// the column menu button, a board card holding links) must not become a
+// second interactive layer: WCAG forbids nested interactive elements. We
+// strip every activator attribute dnd-kit or React (re)writes on it so the
+// wrapper stays a pointer-only drag surface.
+export const hasInteractiveDescendant = (element: Element) =>
+  element.querySelector(INTERACTIVE_DESCENDANT_SELECTOR) !== null;
+
+export const neutralizeDragActivatorSemantics = (element: Element) => {
+  const strip = () => {
+    for (const attribute of NEUTRALIZED_ATTRIBUTES) {
+      element.removeAttribute(attribute);
+    }
+  };
+
+  strip();
+
+  if (!suppressorsByElement.has(element)) {
+    const observer = new MutationObserver(strip);
+    observer.observe(element, {
+      attributes: true,
+      attributeFilter: NEUTRALIZED_ATTRIBUTES,
+    });
+    suppressorsByElement.set(element, observer);
+  }
+};
diff --git a/packages/twenty-front/src/modules/ui/utilities/drag-and-drop/utils/observeDragActivatorAccessibleName.ts b/packages/twenty-front/src/modules/ui/utilities/drag-and-drop/utils/observeDragActivatorAccessibleName.ts
new file mode 100644
index 0000000000..0ef7579d2f
--- /dev/null
+++ b/packages/twenty-front/src/modules/ui/utilities/drag-and-drop/utils/observeDragActivatorAccessibleName.ts
@@ -0,0 +1,52 @@
+const observersByElement = new WeakMap<Element, MutationObserver>();
+
+const visibleText = (element: HTMLElement) => {
+  const collected: string[] = [];
+  const walker = document.createTreeWalker(element, NodeFilter.SHOW_TEXT);
+  let node = walker.nextNode();
+  while (node !== null) {
+    const parent = node.parentElement;
+    if (
+      parent !== null &&
+      parent.getAttribute('aria-hidden') !== 'true' &&
+      parent.closest('[aria-hidden="true"]') === null
+    ) {
+      collected.push(node.textContent ?? '');
+    }
+    node = walker.nextNode();
+  }
+  return collected.join(' ').replace(/\s+/g, ' ').trim();
+};
+
+// dnd-kit names each activator after its sortable id (e.g. "KGi3u9") and
+// applies it asynchronously, overwriting whatever aria-label React rendered.
+// The observer rewrites the name every time: the element's visible text when
+// there is one (WCAG 2.5.3 label = visible text), otherwise a fallback.
+export const observeDragActivatorAccessibleName = (
+  element: HTMLElement,
+  resolveFallbackAccessibleName: string | (() => string),
+) => {
+  const restoreAccessibleName = () => {
+    const text = visibleText(element);
+    const wanted =
+      text === ''
+        ? typeof resolveFallbackAccessibleName === 'function'
+          ? resolveFallbackAccessibleName()
+          : resolveFallbackAccessibleName
+        : text;
+    if (element.getAttribute('aria-label') !== wanted) {
+      element.setAttribute('aria-label', wanted);
+    }
+  };
+
+  restoreAccessibleName();
+
+  if (!observersByElement.has(element)) {
+    const observer = new MutationObserver(restoreAccessibleName);
+    observer.observe(element, {
+      attributes: true,
+      attributeFilter: ['aria-label'],
+    });
+    observersByElement.set(element, observer);
+  }
+};
