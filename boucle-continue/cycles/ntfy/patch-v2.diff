+// MUI portals default to document.body, which drops menus/popovers outside every
+// landmark (axe `region`) and, when a modal is open, outside the active tree.
+// Mounting them on this dedicated sibling layer keeps them inside a named
+// complementary landmark instead.
+const popupContainer = () => document.getElementById("a11y-popup-layer");
+
+export default popupContainer;
