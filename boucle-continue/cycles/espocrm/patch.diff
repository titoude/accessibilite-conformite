@@ -0,0 +1,83 @@
+// a11y-c47: accessibility contrast & sizing overrides (cycle 47 patch).
+:root {
+    --gray-soft: #6a6a6a;
+    --text-muted-color: #6e6e6e;
+    --btn-primary-bg: #3f6da2;
+    --btn-primary-border: #3f6da2;
+    --btn-primary-hover-bg: #36608f;
+    --btn-primary-active-bg: #315683;
+    --btn-primary-hover-border: #36608f;
+    --btn-primary-active-border: #2e527c;
+    --state-primary-text: #22689a;
+    --state-info-text: #6b5c8a;
+    --state-default-text: #4d4d4d;
+}
+
+// Muted stream timestamps / secondary text on light panels.
+.text-soft {
+    color: var(--gray-soft);
+}
+
+// Sortable column headers inherit the muted link color; force solid text.
+th .sort,
+.field-header-cell .sort {
+    color: var(--text-color);
+}
+
+// Small field links (website, url) need a >=24px hit area.
+.field .link-container a,
+.field a.selectable {
+    padding-top: var(--4px);
+    padding-bottom: var(--4px);
+    display: inline-block;
+}
+
+// Status labels (bootstrap .label-*): white text needs darker backgrounds.
+.label-warning { background-color: #8a5c07; }
+.label-success { background-color: #237a42; }
+.label-default { background-color: #6f6f6f; }
+.label-danger  { background-color: #a2354f; }
+.label-primary { background-color: #3f6da2; }
+.label-info    { background-color: #4a7d9e; }
+
+// Warning/info texts on light backgrounds.
+.text-warning { color: #8a621c; }
+a.text-warning { color: #8a621c; }
+
+// Dropdown section headers + side-menu divider labels.
+.dropdown-header { color: #6e6e6e; }
+li.tab-divider .nav-divider-text > .label-text,
+li.tab-divider > div > .label-text { color: #c9c9c9; }
+
+// Links inside headings must be distinguishable without color.
+.page-header h1 a, .admin-content h1 a, h1 > a[href] { text-decoration: underline; }
+
+
+// label-state (liste statuts entités) : fond foncé + texte blanc >= 4.5.
+.label.label-state.label-success { color: #fff; background-color: #237a42; }
+.label.label-state.label-warning { color: #fff; background-color: #8a5c07; }
+.label.label-state.label-danger  { color: #fff; background-color: #a23450; }
+.label.label-state.label-primary { color: #fff; background-color: #3f6da2; }
+.label.label-state.label-info    { color: #fff; background-color: #4a7d9e; }
+.label.label-state.label-default { color: #fff; background-color: #6f6f6f; }
+
+// target-size : liens de cellules tableau (champs url/email/téléphone)
+.list-container table td > a[href] { padding-top: 4px; padding-bottom: 4px; }
+
+
+// text-success/warning/... (boutons suivre/unfollow, statuts)
+.text-success { color: #237a42 !important; }
+.text-warning { color: #8a5c07 !important; }
+.text-danger  { color: #a23450 !important; }
+.text-info    { color: #4a7d9e !important; }
+
+// labels de séparateurs du menu latéral (fond sombre)
+.nav-divider-text .label-text { color: #5a5a5a !important; }
+
+// target-size : liens dans cellules de liste (quel que soit l'état/menu ouvert)
+table td > a[href].text-default,
+.list-container td a[href],
+table.list td a[href] { padding: 6px 0 !important; display: inline-block !important; }
+
+// target-size : liens de champs en vue détail (website, email, téléphone)
+.detail .field a[href] { padding: 6px 0 !important; display: inline-block !important; }
