 import am4themes_material from "@amcharts/amcharts4/themes/material";
 
+// Les SVG générés par amCharts exposent des landmarks/rôles imbriqués
+// (g[role="region"], g[role="scrollbar"], aria-labelledby internes) que axe
+// signale. Le graphique reste visible ; on le retire de l'arbre a11y.
+const hideChartFromAT = (chart: am4core.Container): void => {
+  // Le conteneur reste accessible (menu d'export focalisable) ; seul le svg
+  // décoratif et ses landmarks internes quittent l'arbre a11y.
+  const hideSvg = (): void => {
+    const container = chart.svgContainer && chart.svgContainer.htmlElement;
+    const svg = container ? container.querySelector("svg") : null;
+    if (svg) {
+      svg.setAttribute("aria-hidden", "true");
+      svg.setAttribute("focusable", "false");
+      svg.querySelectorAll("[tabindex]").forEach((focusable) => {
+        focusable.removeAttribute("tabindex");
+      });
+    }
+  };
+  hideSvg();
+  chart.events.onAll(hideSvg);
+};
+
