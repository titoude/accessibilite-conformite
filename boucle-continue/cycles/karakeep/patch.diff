diff --git a/packages/shared-react/hooks/useModalContainer.ts b/packages/shared-react/hooks/useModalContainer.ts
new file mode 100644
index 00000000..b0e5a6a9
--- /dev/null
+++ b/packages/shared-react/hooks/useModalContainer.ts
@@ -0,0 +1,20 @@
+"use client";
+
+import * as React from "react";
+
+// Monté dans <main> (voir apps/web/components/shared/sidebar/SidebarLayout.tsx) :
+// les overlays Radix (menus, selects, dialogues) sont portalés dedans pour que
+// 1) le contenu des overlays reste dans un landmark (WCAG 1.3.1 / axe "region")
+// 2) le wrapper applicatif ne soit pas aria-hidden quand un overlay modal
+//    s'ouvre (sinon axe signale aria-hidden-focus + perte de landmark/h1).
+export const MODAL_ROOT_ID = "karakeep-modal-root";
+
+// Retourne l'élément hôte une fois le DOM prêt ; undefined => document.body
+// (comportement Radix par défaut — utilisé hors des pages dashboard).
+export function useModalContainer(): HTMLElement | undefined {
+  const [container, setContainer] = React.useState<HTMLElement | undefined>();
+  React.useEffect(() => {
+    setContainer(document.getElementById(MODAL_ROOT_ID) ?? undefined);
+  }, []);
+  return container;
+}
