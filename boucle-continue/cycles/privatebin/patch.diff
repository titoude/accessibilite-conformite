             PasteViewer.hide();
 
@@ -2409,6 +2411,8 @@ window.PrivateBin = (function () {
 
             messageEdit.setAttribute('aria-selected', 'false');
             messagePreview.setAttribute('aria-selected', 'true');
+            messageEdit.setAttribute('tabindex', '-1');
+            messagePreview.setAttribute('tabindex', '0');
 
             // hide input as now preview is shown
             message.classList.add('hidden');
@@ -2556,6 +2560,37 @@ window.PrivateBin = (function () {
                 messagePreview.addEventListener('click', viewPreview);
                 messagePreviewParent = messagePreview.parentElement;
             }
+
+            // ARIA tablist keyboard support: arrow keys move focus between
+            // tabs, Home/End jump to first/last tab.
+            const handleTabKeydown = function (event) {
+                const tabs = [messageEdit, messagePreview].filter(t => t);
+                const idx = tabs.indexOf(event.currentTarget);
+                if (idx < 0) {
+                    return;
+                }
+                let next = -1;
+                if (event.key === 'ArrowRight' || event.key === 'ArrowDown') {
+                    next = (idx + 1) % tabs.length;
+                } else if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') {
+                    next = (idx - 1 + tabs.length) % tabs.length;
+                } else if (event.key === 'Home') {
+                    next = 0;
+                } else if (event.key === 'End') {
+                    next = tabs.length - 1;
+                }
+                if (next >= 0 && next !== idx) {
+                    event.preventDefault();
+                    tabs[next].focus();
+                    tabs[next].click();
+                }
+            };
+            if (messageEdit) {
+                messageEdit.addEventListener('keydown', handleTabKeydown);
+            }
+            if (messagePreview) {
+                messagePreview.addEventListener('keydown', handleTabKeydown);
+            }
         };
 
         return me;
