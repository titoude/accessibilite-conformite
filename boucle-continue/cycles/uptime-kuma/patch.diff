+         * Text color that keeps at least 4.5:1 contrast on the tag's
+         * background color: dark text on light tags, white on dark tags.
+         * @returns {string} CSS color
+         */
+        textColor() {
+            const hex = (this.item.color || "").replace("#", "");
+            if (!/^[0-9a-f]{6}$/i.test(hex)) {
+                return "#fff";
+            }
+            const channel = (i) => {
+                const c = parseInt(hex.substring(i, i + 2), 16) / 255;
+                return c <= 0.04045 ? c / 12.92 : Math.pow((c + 0.055) / 1.055, 2.4);
+            };
+            const luminance = 0.2126 * channel(0) + 0.7152 * channel(2) + 0.0722 * channel(4);
+            const white = (1.05) / (luminance + 0.05);
+            const dark = (luminance + 0.05) / (0.003 + 0.05);
+            return white >= dark ? "#fff" : "#020b05";
+        },
     },
