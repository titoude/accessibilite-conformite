diff --git a/src/components/AccessibleMultiselect.vue b/src/components/AccessibleMultiselect.vue
new file mode 100644
index 00000000..5d956d37
--- /dev/null
+++ b/src/components/AccessibleMultiselect.vue
@@ -0,0 +1,63 @@
+<template>
+    <VueMultiselect ref="inner" v-bind="$attrs" :id="resolvedId">
+        <template v-for="(_, name) in $slots" #[name]="slotData">
+            <slot :name="name" v-bind="slotData || {}" />
+        </template>
+    </VueMultiselect>
+</template>
+
+<script>
+import VueMultiselect from "vue-multiselect";
+
+/**
+ * Wrapper around vue-multiselect that repairs the ARIA wiring the library
+ * omits: the root combobox div gets aria-expanded (kept in sync with the
+ * open/closed state via the multiselect--active class) and aria-controls
+ * (mirroring aria-owns). The remove-tag icon's tabindex="1" is rewritten
+ * to tabindex="0" so it stays focusable without hijacking tab order.
+ */
+export default {
+    components: {
+        VueMultiselect,
+    },
+    inheritAttrs: false,
+    data() {
+        return {
+            // vue-multiselect builds its listbox id as `listbox-${id}`; with
+            // id=null every instance shares "listbox-null" (duplicate-id-aria).
+            resolvedId: this.$attrs.id ?? `ms-${self.crypto && self.crypto.randomUUID ? self.crypto.randomUUID().slice(0, 8) : Math.random().toString(36).slice(2, 10)}`,
+        };
+    },
+    mounted() {
+        const root = this.$refs.inner && this.$refs.inner.$el ? this.$refs.inner.$el : this.$el;
+
+        const sync = () => {
+            const owns = root.getAttribute("aria-owns");
+            if (owns && !root.getAttribute("aria-controls")) {
+                root.setAttribute("aria-controls", owns);
+            }
+            const open = root.classList.contains("multiselect--active");
+            if (root.getAttribute("aria-expanded") !== String(open)) {
+                root.setAttribute("aria-expanded", String(open));
+            }
+            root.querySelectorAll('.multiselect__tag-icon[tabindex="1"]').forEach(icon => {
+                icon.setAttribute("tabindex", "0");
+            });
+        };
+
+        this._ariaObserver = new MutationObserver(sync);
+        this._ariaObserver.observe(root, {
+            attributes: true,
+            attributeFilter: [ "class" ],
+            subtree: true,
+            childList: true,
+        });
+        sync();
+    },
+    beforeUnmount() {
+        if (this._ariaObserver) {
+            this._ariaObserver.disconnect();
+        }
+    },
+};
+</script>
