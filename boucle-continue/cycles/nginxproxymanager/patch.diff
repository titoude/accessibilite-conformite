+}
+/* Contraste WCAG AA (≥4.5:1 vérifié par axe) sur les utilitaires Tabler teintés.
+   Le texte de bouton est #f9fafb : chaque teinte de fond est assombrie pour garder
+   la marge requise, y compris au survol (variante -darken). */
+
+/* Boutons d'action des modales (classes utilitaires bg-* portées sur .btn). */
+.btn.bg-lime {
+  --tblr-lime: #4b770e;
+}
+.btn.bg-yellow {
+  --tblr-yellow: #956000;
+}
+.btn.bg-cyan {
+  --tblr-cyan: #107686;
+}
+.btn.bg-teal {
+  --tblr-teal: #087c59;
+}
+.btn.bg-azure {
+  --tblr-azure: #306fa4;
+}
+.btn.bg-orange {
+  --tblr-orange: #b44b05;
+}
+.btn.bg-green {
+  --tblr-green: #207b2e;
+}
+.btn.bg-red {
+  --tblr-red: #c73535;
+}
+.btn.bg-pink {
+  --tblr-pink: #c72f64;
+}
+.btn.bg-blue {
+  --tblr-blue: #0569c6;
+}
+
+/* Variantes .btn-{couleur} complètes (boutons « Add » des tables, etc.). */
+.btn-lime {
+  --tblr-lime: #4b770e;
+  --tblr-lime-darken: #436b0c;
+}
+.btn-yellow {
+  --tblr-yellow: #956000;
+  --tblr-yellow-darken: #865700;
+}
+.btn-red {
+  --tblr-red: #c73535;
+  --tblr-red-darken: #b32f2f;
+}
+.btn-cyan {
+  --tblr-cyan: #107686;
+  --tblr-cyan-darken: #0f6a78;
+}
+.btn-blue {
+  --tblr-blue: #0569c6;
+  --tblr-blue-darken: #055eb2;
+}
+.btn-orange {
+  --tblr-orange: #b44b05;
+  --tblr-orange-darken: #a24304;
+}
+.btn-pink {
+  --tblr-pink: #c72f64;
+  --tblr-pink-darken: #b32a5a;
+}
+.btn-teal {
+  --tblr-teal: #087c59;
+  --tblr-teal-darken: #087050;
+}
+.btn-azure {
+  --tblr-azure: #306fa4;
+  --tblr-azure-darken: #2b6493;
+}
+.btn-green {
+  --tblr-green: #207b2e;
+  --tblr-green-darken: #1d6f2a;
+}
+.btn-purple {
+  --tblr-purple: #a53abe;
+  --tblr-purple-darken: #9435ab;
+}
+
+/* Texte teinté sur badges -lt : la teinte par défaut (ex. yellow #f59f00) tombe
+   sous 4.5:1 sur le fond clair du badge — on assombrit la même famille. */
+.badge.bg-yellow-lt,
+.badge.bg-lime-lt,
+.badge.bg-orange-lt,
+.badge.bg-cyan-lt,
+.badge.bg-teal-lt,
+.badge.bg-azure-lt,
+.badge.bg-green-lt,
+.badge.bg-red-lt,
+.badge.bg-pink-lt,
+.badge.bg-blue-lt,
+a.bg-yellow-lt,
+a.bg-lime-lt,
+a.bg-orange-lt,
+a.bg-cyan-lt,
+a.bg-teal-lt,
+a.bg-azure-lt,
+a.bg-green-lt,
+a.bg-red-lt,
+a.bg-pink-lt,
+a.bg-blue-lt {
+  --tblr-yellow: #956000;
+  --tblr-lime: #4b770e;
+  --tblr-orange: #b44b05;
+  --tblr-cyan: #107686;
+  --tblr-teal: #087c59;
+  --tblr-azure: #306fa4;
+  --tblr-green: #207b2e;
+  --tblr-red: #c73535;
+  --tblr-pink: #c72f64;
+  --tblr-blue: #0569c6;
+}
+
+/* Indicateurs .status-{couleur} (points + libellé) : mêmes teintes assombries. */
+.status.status-lime {
+  --tblr-status-color: #4b770e;
+}
+.status.status-yellow {
+  --tblr-status-color: #956000;
+}
+.status.status-orange {
+  --tblr-status-color: #b44b05;
+}
+.status.status-cyan {
+  --tblr-status-color: #107686;
+}
+.status.status-teal {
+  --tblr-status-color: #087c59;
+}
+.status.status-azure {
+  --tblr-status-color: #306fa4;
+}
+.status.status-green {
+  --tblr-status-color: #207b2e;
+}
+.status.status-red {
+  --tblr-status-color: #c73535;
+}
+.status.status-pink {
+  --tblr-status-color: #c72f64;
+}
+.status.status-blue {
+  --tblr-status-color: #0569c6;
+}
+
+/* Textes utilitaires .text-{couleur} trop clairs sur blanc. */
+.text-lime {
+  --tblr-lime: #4b770e;
+}
+.text-yellow {
+  --tblr-yellow: #956000;
+}
+.text-orange {
+  --tblr-orange: #b44b05;
+}
+.text-cyan {
+  --tblr-cyan: #107686;
+}
+.text-teal {
+  --tblr-teal: #087c59;
+}
+.text-azure {
+  --tblr-azure: #306fa4;
+}
+.text-green {
+  --tblr-green: #207b2e;
+}
+
+/* Bouton « Live » des logs (btn-success) et lien « update available ». */
+.btn-success {
+  --tblr-success: #207b2e;
+  --tblr-success-darken: #1d6f2a;
+}
+.link-warning {
+  --tblr-warning: #956000;
+}
+
+/* Muted text dans la navbar : la valeur text-secondary par défaut échoue à 4.5:1. */
+.navbar .text-secondary {
+  color: #57606c !important;
+}
+[data-bs-theme="dark"] .navbar .text-secondary {
+  color: #a5aeb8 !important;
+}
+
+/* Lignes de log en danger sur fond sombre du viewer (rouge trop sombre sur #111827). */
+.logBox .text-danger,
+pre .text-danger {
+  color: #ff7d7d !important;
+}
