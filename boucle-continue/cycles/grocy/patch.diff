diff --git a/public/viewjs/openapiui.js b/public/viewjs/openapiui.js
index 3bc95c0f..1dfb1d59 100644
--- a/public/viewjs/openapiui.js
+++ b/public/viewjs/openapiui.js
@@ -26,3 +26,61 @@ const swaggerUi = SwaggerUIBundle({
 });
 
 window.ui = swaggerUi;
+
+// A11y : assainir le DOM rendu par swagger-ui (interactifs imbriqués, ordre des titres, labels)
+function SwaggerUiA11y(root)
+{
+	var scope = root || document;
+
+	scope.querySelectorAll(".opblock-summary-control a.nostyle").forEach(function (a)
+	{
+		// L'ancre imbriquée dans le bouton de résumé n'est pas destinée à être activée
+		// (le bouton gère déjà l'expansion) — on lui retire son caractère interactif.
+		a.removeAttribute("href");
+		a.removeAttribute("target");
+	});
+
+	scope.querySelectorAll("h3.opblock-tag").forEach(function (h)
+	{
+		// h1 > h3 est un saut de niveau — présenter le tag comme un titre de niveau 2
+		// sans remplacer le nœud (swagger-ui/React le réutilise lors du re-rendu).
+		h.setAttribute("role", "heading");
+		h.setAttribute("aria-level", "2");
+	});
+
+	scope.querySelectorAll("hgroup a.link").forEach(function (a)
+	{
+		// Le texte du lien (.url) est masqué par le style du template — le nom
+		// accessible doit donc venir d'un aria-label explicite.
+		if (!a.getAttribute("aria-label"))
+		{
+			a.setAttribute("aria-label", "OpenAPI specification");
+		}
+	});
+
+	// La section info précède le <main id="operations"> de swagger-ui : lui donner
+	// un landmark nommé pour que tout le contenu reste dans un landmark.
+	scope.querySelectorAll(".information-container").forEach(function (c)
+	{
+		c.setAttribute("role", "region");
+		if (!c.getAttribute("aria-label"))
+		{
+			c.setAttribute("aria-label", "API information");
+		}
+	});
+}
+
+SwaggerUiA11y();
+new MutationObserver(function (mutations)
+{
+	mutations.forEach(function (m)
+	{
+		m.addedNodes.forEach(function (n)
+		{
+			if (n.nodeType === 1)
+			{
+				SwaggerUiA11y(n.parentNode || document);
+			}
+		});
+	});
+}).observe(document.body, { childList: true, subtree: true });
