+// A11y : quand le défilement du menu latéral se stabilise, aligner l'entrée
+// à cheval sur un bord pour ne laisser ni fine bande visible ni cible tronquée.
+// En bas, on ajoute si besoin une marge pour que le dernier item soit entier.
+var sidenavSnapTimer = null;
+$(".navbar-sidenav").on("scroll", function()
+{
+	clearTimeout(sidenavSnapTimer);
+	sidenavSnapTimer = setTimeout(function()
+	{
+		var nav = $(".navbar-sidenav")[0];
+		if (!nav)
+		{
+			return;
+		}
+		var ul = nav.querySelector("ul.navbar-nav");
+		for (var pass = 0; pass < 12; pass++)
+		{
+			var navTop = nav.getBoundingClientRect().top;
+			var navBottom = nav.getBoundingClientRect().bottom;
+			var topStr = null;
+			var botStr = null;
+			$(nav).find("a.nav-link").each(function()
+			{
+				var r = this.getBoundingClientRect();
+				if (r.top < navTop && r.bottom > navTop && (r.bottom - navTop) < 24 && !topStr)
+				{
+					topStr = { el: this, vis: r.bottom - navTop };
+				}
+				if (r.top < navBottom && r.bottom > navBottom && (navBottom - r.top) < 24)
+				{
+					botStr = { el: this, over: r.bottom - navBottom };
+				}
+			});
+			if (topStr)
+			{
+				nav.scrollTop += Math.ceil(topStr.vis);
+			}
+			else if (botStr)
+			{
+				var need = Math.ceil(botStr.over);
+				if (nav.scrollTop + need > nav.scrollHeight - nav.clientHeight && ul)
+				{
+					ul.style.paddingBottom = need + "px";
+				}
+				nav.scrollTop += need;
+			}
+			else
+			{
+				break;
+			}
+		}
+}, 200);
+});
