+// A11y : l'initialisation des tooltips Bootstrap vide l'attribut `title`
+// (déplacé vers `data-original-title`), donc les contrôles icône-seuls
+// perdent leur nom accessible. On recopie l'intitulé dans `aria-label`,
+// y compris pour les éléments injectés tardivement (DataTables, calendrier).
+function EnsureTooltipLabels(root)
+{
+	$(root || document).find("[data-toggle='tooltip']").addBack("[data-toggle='tooltip']").each(function ()
+	{
+		var el = $(this);
+		// aria-label est prohibé sur les éléments non interactifs (icônes <i>/<span> décoratives)
+		if (!el.is("a, button, input, select, textarea, [role], [tabindex]"))
+		{
+			return;
+		}
+		if (el.attr("aria-label") || el.attr("aria-labelledby"))
+		{
+			return;
+		}
+		var label = el.attr("data-original-title") || el.attr("title");
+		if (label && $.trim(el.text()).length === 0)
+		{
+			el.attr("aria-label", label);
+		}
+	});
+}
+EnsureTooltipLabels();
+new MutationObserver(function (mutations)
+{
+	mutations.forEach(function (mutation)
+	{
+		mutation.addedNodes.forEach(function (node)
+		{
+			if (node.nodeType === 1)
+			{
+				EnsureTooltipLabels(node);
+			}
+		});
+	});
+}).observe(document.body, { childList: true, subtree: true });
