@@ -14,6 +14,73 @@ class CalendarService extends BaseService
 
 	private $UrlManager;
 
+	private static function LuminanceOf($r, $g, $b)
+	{
+		foreach (array(&$r, &$g, &$b) as &$c)
+		{
+			$c /= 255;
+			$c = $c <= 0.03928 ? $c / 12.92 : pow(($c + 0.055) / 1.055, 2.4);
+		}
+		return 0.2126 * $r + 0.7152 * $g + 0.0722 * $b;
+	}
+
+	private static function ContrastRatio($l1, $l2)
+	{
+		if ($l1 < $l2)
+		{
+			$tmp = $l1;
+			$l1 = $l2;
+			$l2 = $tmp;
+		}
+		return ($l1 + 0.05) / ($l2 + 0.05);
+	}
+
+	// A11y : renvoie [color, textColor] exploitables par FullCalendar —
+	// le texte est noir ou blanc au meilleur contraste, et si la couleur choisie
+	// par l'utilisateur ne permet aucun des deux (tons médians), le fond est
+	// assombri jusqu'à atteindre WCAG AA avec du texte blanc.
+	private static function GetEventColors($bgColor)
+	{
+		$hex = ltrim(trim($bgColor), '#');
+		if (strlen($hex) === 3)
+		{
+			$hex = $hex[0] . $hex[0] . $hex[1] . $hex[1] . $hex[2] . $hex[2];
+		}
+		if (strlen($hex) !== 6)
+		{
+			// Couleur utilisateur absente/invalide : repartir du bleu FullCalendar
+			// par défaut (#3a87ad), qui est lui-même ajusté ci-dessous.
+			$hex = '3a87ad';
+		}
+		$r = hexdec(substr($hex, 0, 2));
+		$g = hexdec(substr($hex, 2, 2));
+		$b = hexdec(substr($hex, 4, 2));
+
+		$lDark = self::LuminanceOf(33, 37, 41); // #212529
+		$l = self::LuminanceOf($r, $g, $b);
+		if (self::ContrastRatio(1.0, $l) >= 4.5)
+		{
+			return array('color' => $bgColor, 'textColor' => '#ffffff');
+		}
+		if (self::ContrastRatio($l, $lDark) >= 4.5)
+		{
+			return array('color' => $bgColor, 'textColor' => '#212529');
+		}
+
+		// Assombrir progressivement jusqu'à ce que le texte blanc atteigne AA
+		for ($k = 0.95; $k >= 0.05; $k -= 0.05)
+		{
+			$r2 = (int) round($r * $k);
+			$g2 = (int) round($g * $k);
+			$b2 = (int) round($b * $k);
+			if (self::ContrastRatio(1.0, self::LuminanceOf($r2, $g2, $b2)) >= 4.5)
+			{
+				return array('color' => sprintf('#%02x%02x%02x', $r2, $g2, $b2), 'textColor' => '#ffffff');
+			}
+		}
+		return array('color' => '#212529', 'textColor' => '#ffffff');
+	}
