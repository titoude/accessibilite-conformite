+#!/usr/bin/env node
+/**
+ * eval-final.mjs — évaluation INDÉPENDANTE miniflux (assertions différentes de
+ * verify.mjs, écrite après la boucle de correction).
+ */
+import { createRequire } from 'node:module';
+import { resolve } from 'node:path';
+const require = createRequire(resolve(process.cwd(), 'package.json'));
+const { chromium } = require('playwright');
+
+const BASE = process.env.MINIFLUX_URL || 'http://127.0.0.1:8081';
+const STORAGE = process.env.MINIFLUX_STORAGE || 'miniflux-auth.json';
+const results = [];
+const check = (name, ok, detail = '') => {
+  results.push({ name, ok });
+  console.log(`${ok ? 'PASS' : 'FAIL'} ${name}${detail ? ' — ' + detail : ''}`);
+};
+
+const PAGES = ['/unread', '/unread/entry/1', '/starred', '/history', '/feeds',
+  '/feed/1/entries', '/feed/1/edit', '/subscribe', '/categories',
+  '/category/1/entries', '/category/create', '/search', '/settings',
+  '/sessions', '/keys', '/keys/create', '/import', '/integrations',
+  '/users', '/user/create', '/users/1/edit', '/about', '/shares'];
+
+const browser = await chromium.launch();
+const context = await browser.newContext({ storageState: STORAGE });
+const page = await context.newPage();
+
+for (const p of PAGES) {
+  await page.goto(`${BASE}${p}`, { waitUntil: 'networkidle' });
+  const m = await page.evaluate(() => {
+    const ids = [...document.querySelectorAll('[id]')].map(e => e.id);
+    const dups = ids.filter((v, i) => ids.indexOf(v) !== i);
+    const controls = [...document.querySelectorAll('input:not([type=hidden]):not([type=submit]), select, textarea')]
+      .filter(e => e.checkVisibility());
+    const unlabeled = controls.filter(e => {
+      const id = e.id;
+      const labelled = id && document.querySelector(`label[for="${id}"]`);
+      const wrapped = e.closest('label');
+      return !(labelled || wrapped || e.getAttribute('aria-label') || e.getAttribute('aria-labelledby') || e.getAttribute('title'));
+    }).map(e => e.name || e.id || e.type);
+    return {
+      lang: document.documentElement.lang, title: document.title,
+      h1: document.querySelectorAll('h1').length,
+      main: document.querySelectorAll('main').length,
+      nav: document.querySelectorAll('nav').length,
+      skip: !!document.querySelector('.skip-to-content-link'),
+      dups: [...new Set(dups)], unlabeled,
+    };
+  });
+  check(`${p}: lang/title/h1/main/nav/skip`, !!m.lang && !!m.title && m.h1 >= 1 && m.main === 1 && m.nav >= 1 && m.skip,
+    `lang=${m.lang} h1=${m.h1} main=${m.main} nav=${m.nav} skip=${m.skip}`);
+  check(`${p}: no dup ids`, m.dups.length === 0, m.dups.join(','));
+  check(`${p}: controls named`, m.unlabeled.length === 0, m.unlabeled.join(','));
+}
+
+// Contrast indépendant d'axe : méta texte sur fond teinté (liste feeds/catégories)
+for (const u of ['/feeds', '/categories']) {
+  await page.goto(`${BASE}${u}`, { waitUntil: 'networkidle' });
+  const worst = await page.evaluate(() => {
+    const lum = c => { const v = c.map(x => { x /= 255; return x <= 0.03928 ? x / 12.92 : ((x + 0.055) / 1.055) ** 2.4; }); return 0.2126 * v[0] + 0.7152 * v[1] + 0.0722 * v[2]; };
+    const px = s => s.match(/[\d.]+/g).map(Number);
+    let min = 99;
+    for (const e of document.querySelectorAll('a, button, time, span, li')) {
+      const s = getComputedStyle(e);
+      if (!e.offsetParent || !e.textContent.trim() || parseFloat(s.fontSize) === 0) continue;
+      let bg = null, el = e;
+      while (el && !bg) { const c = px(getComputedStyle(el).backgroundColor); if (c.length >= 4 && c[3] === 0) { el = el.parentElement; continue; } bg = c.slice(0, 3); }
+      if (!bg) bg = [255, 255, 255];
+      const fg = px(s.color);
+      const r = (Math.max(lum(fg), lum(bg)) + 0.05) / (Math.min(lum(fg), lum(bg)) + 0.05);
+      if (r < min) min = r;
+    }
+    return min;
+  });
+  check(`${u}: worst text contrast >= 4.5`, worst >= 4.5, worst.toFixed(2));
+}
+
+// Modale : Tab cycle dans le dialog (focus trap natif)
+await page.goto(`${BASE}/unread`, { waitUntil: 'networkidle' });
+await page.keyboard.press('?');
+await page.waitForSelector('dialog#keyboard-shortcuts-modal[open]');
+let escapedInteractive = null;
+for (let i = 0; i < 8; i++) {
+  await page.keyboard.press('Tab');
+  const hit = await page.evaluate(() => {
+    const a = document.activeElement;
+    const dlg = document.getElementById('keyboard-shortcuts-modal');
+    const interactive = a.matches('a[href], button, input, select, textarea, [tabindex]:not([tabindex="-1"])');
+    return interactive && a !== dlg && !dlg.contains(a) ? `${a.tagName}.${a.className}` : null;
+  });
+  if (hit) { escapedInteractive = hit; break; }
+}
+check('modal: Tab never reaches interactive background content', !escapedInteractive, escapedInteractive || '');
+// arrière-plan inerte : un clic à l'extérieur frappe le backdrop, jamais un élément de la page
+const backdropTarget = await page.evaluate(() => {
+  const e = document.elementFromPoint(5, 5);
+  return e ? e.tagName + (e === document.getElementById('keyboard-shortcuts-modal') ? ' (dialog/backdrop)' : '') : 'null';
+});
+check('modal: backdrop intercepts clicks (background inert)', backdropTarget.includes('DIALOG'), backdropTarget);
+await page.keyboard.press('Escape');
+
+// Pagination désactivée = texte non interactif
+await page.goto(`${BASE}/unread`, { waitUntil: 'networkidle' });
+const disabledInteractive = await page.evaluate(() => {
+  const d = document.querySelectorAll('.pagination .disabled a, .pagination .disabled button');
+  return d.length;
+});
+check('pagination: disabled items are not links/buttons', disabledInteractive === 0);
+
+// Parcours métier #2 : recherche d'entrée → résultats → ouverture contexte search
+await page.goto(`${BASE}/search`, { waitUntil: 'networkidle' });
+await page.fill('#search-input', 'Release');
+await Promise.all([page.waitForNavigation({ waitUntil: 'networkidle' }), page.press('#search-input', 'Enter')]);
+const hits = await page.locator('article').count();
+check('journey: search finds seeded entry', hits >= 1, `${hits} article(s)`);
+if (hits) {
+  await page.locator('.item-title a').first().click();
+  await page.waitForURL(/\/search\/entry\/\d+|\/entry\/\d+/, { timeout: 10000 });
+  check('journey: entry opens from search context', true, page.url());
+}
+
+// Marquer lu via bouton -> classe change OU liste vidée (showOnlyUnread reload)
+await page.goto(`${BASE}/unread`, { waitUntil: 'networkidle' });
+const before = await page.locator('article.item-status-unread').count();
+if (before > 0) {
+  await page.locator('article.item-status-unread button[data-toggle-status]').first().click();
+  await page.waitForTimeout(800);
+  const nArt = await page.locator('article').count();
+  const cls = nArt ? await page.locator('article').first().getAttribute('class') : 'list-emptied';
+  check('journey: mark-as-read applies (class flip or list refresh)', cls.includes('read') || nArt === 0, cls);
+} else {
+  check('journey: mark-as-read applies (class flip or list refresh)', false, 'no unread entry to toggle');
+}
+
+await browser.close();
+const failed = results.filter(r => !r.ok);
+console.log(`\nEVAL-FINAL: ${results.length - failed.length}/${results.length} passed`);
+process.exit(failed.length ? 1 : 0);
