+/**
+ * Returns $color darkened until its WCAG contrast ratio against $bg reaches
+ * $target (default 4.6 >= AA for normal text). Used by themes for text-sized
+ * usages of the user-selected brand color.
+ */
+function contrastRatio($colorA, $colorB)
+{
+    $lum = function ($hex) {
+        $hex = ltrim($hex, '#');
+        if (strlen($hex) === 3) {
+            $hex = $hex[0].$hex[0].$hex[1].$hex[1].$hex[2].$hex[2];
+        }
+        $c = array_map(function ($v) {
+            $v /= 255;
+            return $v <= 0.03928 ? $v / 12.92 : (($v + 0.055) / 1.055) ** 2.4;
+        }, [hexdec(substr($hex, 0, 2)), hexdec(substr($hex, 2, 2)), hexdec(substr($hex, 4, 2))]);
+        return 0.2126 * $c[0] + 0.7152 * $c[1] + 0.0722 * $c[2];
+    };
+    $la = $lum($colorA);
+    $lb = $lum($colorB);
+    return (max($la, $lb) + 0.05) / (min($la, $lb) + 0.05);
+}
+
+function accessibleColor($color, $bg = '#faf9f6', $target = 4.6)
+{
+    if (contrastRatio($color, $bg) >= $target) {
+        return $color;
+    }
+    for ($p = 5; $p <= 90; $p += 5) {
+        $darker = darkenColor($color, $p);
+        if (contrastRatio($darker, $bg) >= $target) {
+            return $darker;
+        }
+    }
+    return '#212529';
 }
 
 function getBridgedState()
