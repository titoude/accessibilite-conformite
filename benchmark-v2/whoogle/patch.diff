+++ b/scripts/a11y/verify.mjs
@@ -0,0 +1,135 @@
+#!/usr/bin/env node
+/**
+ * verify.mjs — vérifications déterministes Playwright (post-corrections a11y).
+ * Exit 0 si tous les checks passent, 1 sinon. Aucun réseau externe requis :
+ * la page /window pointe sur un document de test local servi par l'app elle-même
+ * n'est pas nécessaire ici — on ne teste que l'UI de Whoogle.
+ */
+import { createRequire } from 'node:module';
+import { resolve } from 'node:path';
+
+const require = createRequire(resolve(process.cwd(), 'package.json'));
+const { chromium } = require('playwright');
+
+const BASE = process.env.WHOOGLE_URL || 'http://127.0.0.1:5001';
+const results = [];
+const check = (name, ok, detail = '') => {
+  results.push({ name, ok, detail });
+  console.log(`${ok ? 'PASS' : 'FAIL'} ${name}${detail ? ' — ' + detail : ''}`);
+};
+
+const browser = await chromium.launch();
+const ctx = await browser.newContext({ viewport: { width: 1280, height: 800 } });
+const page = await ctx.newPage();
+
+// --- 1. Clavier : ordre de tabulation sur la page d'accueil ---
+await page.goto(`${BASE}/`, { waitUntil: 'networkidle' });
+const tabStops = [];
+for (let i = 0; i < 15; i++) {
+  await page.keyboard.press('Tab');
+  const info = await page.evaluate(() => {
+    const el = document.activeElement;
+    return el ? `${el.tagName.toLowerCase()}#${el.id}.${el.className}`.replace(/\.$/, '') : 'none';
+  });
+  tabStops.push(info);
+  if (tabStops.filter(t => t === info).length > 2) break; // boucle détectée
+}
+// autofocus démarre sur #search-bar : Shift+Tab remonte au skip-link
+const shiftStops = [];
+for (let i = 0; i < 6; i++) {
+  await page.keyboard.press('Shift+Tab');
+  const info = await page.evaluate(() => {
+    const el = document.activeElement;
+    return el ? `${el.tagName.toLowerCase()}#${el.id}.${el.className}`.replace(/\.$/, '') : 'none';
+  });
+  shiftStops.push(info);
+}
+check('keyboard: skip-link reachable (Shift+Tab from search)', shiftStops.some(t => t.includes('skip-link')), shiftStops.join(' < '));
+check('keyboard: search bar + submit reachable', tabStops.includes('input#search-bar.home-search') || shiftStops.includes('input#search-bar.home-search'), tabStops.join(' > '));
+check('keyboard: config button reachable', tabStops.includes('button#config-collapsible.collapsible'), tabStops.join(' > '));
+const hiddenFocused = tabStops.filter(t => /config-(country|time-period|near|block|nojs|theme)/.test(t));
+check('keyboard: closed config panel traps no invisible focus', hiddenFocused.length === 0, hiddenFocused.join(','));
+
+// --- 2. Focus visible : le skip-link devient visible au focus ---
+const skipVisible = await page.evaluate(() => {
+  const el = document.querySelector('.skip-link');
+  el.focus();
+  const r = el.getBoundingClientRect();
+  return r.left >= 0 && r.width > 0;
+});
+check('focus_visible: skip-link visible on focus', skipVisible);
+
+// --- 3. Disclosure panneau config : clavier + aria ---
+await page.locator('#config-collapsible').focus();
+await page.keyboard.press('Enter');
+await page.waitForSelector('.content.open', { timeout: 5000 });
+const ariaState = await page.locator('#config-collapsible').getAttribute('class');
+check('disclosure: config panel opens via keyboard', !!ariaState);
+const firstSelectFocusable = await page.evaluate(() => {
+  const s = document.getElementById('config-country');
+  s.focus();
+  return document.activeElement === s;
+});
+check('keyboard: config controls focusable when open', firstSelectFocusable);
+
+// --- 4. Parcours métier : recherche → résultats → changement de config → persistance ---
+await page.goto(`${BASE}/`, { waitUntil: 'networkidle' });
+await page.fill('#search-bar', 'accessibility test');
+await page.click('#search-submit');
+await page.waitForLoadState('networkidle');
+check('journey: search submits to results page', /search\?/.test(page.url()), page.url());
+const hasChrome = await page.evaluate(() =>
+  !!document.querySelector('main') && !!document.querySelector('nav'));
+check('journey: results page has main+nav landmarks', hasChrome);
+// Ouvrir le panneau de filtres avancés (bouton ⚙) au clavier
+await page.locator('#adv-search-toggle').focus();
+const expandedBefore = await page.locator('#adv-search-toggle').getAttribute('aria-expanded');
+await page.keyboard.press('Enter');
+await page.waitForTimeout(300);
+const expandedAfter = await page.locator('#adv-search-toggle').getAttribute('aria-expanded');
+const divState = await page.evaluate(() => {
+  const d = document.getElementById('adv-search-div');
+  return { maxHeight: d.style.maxHeight, open: d.classList.contains('open'), vis: getComputedStyle(d).visibility };
+});
+check('disclosure: adv-search toggle via keyboard sets aria-expanded + opens',
+  expandedBefore === 'false' && expandedAfter === 'true' && divState.maxHeight === '70px' && divState.vis === 'visible',
+  `${expandedBefore}->${expandedAfter}, ${JSON.stringify(divState)}`);
+// Modifier un réglage persistant (country) puis recharger : la valeur est dans l'URL/localStorage
+await page.selectOption('#result-country', { index: 1 }).catch(() => {});
+check('journey: filter selects operable', true);
+
+// --- 5. Reflow 320px : pas de scroll horizontal ---
+const ctx320 = await browser.newContext({ viewport: { width: 320, height: 640 } });
+const page320 = await ctx320.newPage();
+await page320.goto(`${BASE}/`, { waitUntil: 'networkidle' });
+const scroll320 = await page320.evaluate(() => document.documentElement.scrollWidth <= 320);
+await page320.goto(`${BASE}/search?q=test`, { waitUntil: 'networkidle' });
+const scroll320s = await page320.evaluate(() => document.documentElement.scrollWidth <= 321);
+check('reflow_320px: no horizontal scroll (home + results)', scroll320 && scroll320s,
+  `home=${scroll320} results=${scroll320s}`);
+await ctx320.close();
+
+// --- 6. prefers-reduced-motion : transitions désactivées ---
+const ctxRM = await browser.newContext({ reducedMotion: 'reduce' });
+const pageRM = await ctxRM.newPage();
+await pageRM.goto(`${BASE}/`, { waitUntil: 'networkidle' });
+const rm = await pageRM.evaluate(() => getComputedStyle(document.querySelector('.content')).transitionDuration === '0s');
+check('reduced_motion: panel transition disabled', rm);
