+#!/usr/bin/env node
+/**
+ * eval-final.mjs — évaluation INDÉPENDANTE (assertions différentes de verify.mjs,
+ * menée après la boucle correction→vérif). Mesure, n'estime pas.
+ */
+import { createRequire } from 'node:module';
+import { resolve } from 'node:path';
+const require = createRequire(resolve(process.cwd(), 'package.json'));
+const { chromium } = require('playwright');
+
+const BASE = process.env.WHOOGLE_URL || 'http://127.0.0.1:5001';
+const PAGES = ['/', '/search.html', '/search?q=test', '/window?location=https://example.com'];
+const results = [];
+const check = (name, ok, detail = '') => {
+  results.push({ name, ok, detail });
+  console.log(`${ok ? 'PASS' : 'FAIL'} ${name}${detail ? ' — ' + detail : ''}`);
+};
+
+const browser = await chromium.launch();
+const page = await (await browser.newContext()).newPage();
+
+for (const p of PAGES) {
+  await page.goto(`${BASE}${p}`, { waitUntil: 'networkidle' });
+  const meta = await page.evaluate(() => {
+    const ids = [...document.querySelectorAll('[id]')].map(e => e.id);
+    const dups = ids.filter((v, i) => ids.indexOf(v) !== i);
+    const controls = [...document.querySelectorAll('input:not([type="hidden"]), select, textarea')]
+      .filter(e => e.offsetParent !== null || e.id === 'adv-search-toggle');
+    const unlabeled = controls.filter(e => {
+      const acc = e.labels?.length || e.getAttribute('aria-label') || e.getAttribute('aria-labelledby') || e.getAttribute('title') || e.getAttribute('value');
+      return !acc;
+    }).map(e => e.id || e.name || e.type);
+    return {
+      lang: document.documentElement.lang,
+      title: document.title,
+      h1: document.querySelectorAll('h1').length,
+      mains: document.querySelectorAll('main').length,
+      dups: [...new Set(dups)],
+      unlabeled,
+    };
+  });
+  check(`${p}: lang + title`, !!meta.lang && !!meta.title, `lang=${meta.lang} title="${meta.title}"`);
+  check(`${p}: >=1 h1 and one main`, meta.h1 >= 1 && meta.mains === 1, `h1=${meta.h1} main=${meta.mains}`);
+  check(`${p}: no duplicate ids`, meta.dups.length === 0, meta.dups.join(','));
+  check(`${p}: all visible controls named`, meta.unlabeled.length === 0, meta.unlabeled.join(','));
+}
+
+// Footer link must be underlined (link-in-text-block fix)
+await page.goto(`${BASE}/`, { waitUntil: 'networkidle' });
+const linkDec = await page.evaluate(() => getComputedStyle(document.querySelector('footer .link')).textDecorationLine);
+check('footer link underlined', linkDec.includes('underline'), linkDec);
+
+// Contrast computed on rendered pixels (independent of axe)
+const contrast = await page.evaluate(() => {
+  const lum = (r, g, b) => { const f = x => { x /= 255; return x <= 0.03928 ? x / 12.92 : ((x + 0.055) / 1.055) ** 2.4; }; return 0.2126 * f(r) + 0.7152 * f(g) + 0.0722 * f(b); };
+  const parse = s => s.match(/\d+/g).map(Number);
+  const el = document.getElementById('search-submit');
+  const fg = parse(getComputedStyle(el).color), bg = parse(getComputedStyle(el).backgroundColor);
+  const L1 = lum(...fg), L2 = lum(...bg);
+  return (Math.max(L1, L2) + 0.05) / (Math.min(L1, L2) + 0.05);
+});
+check('#search-submit contrast >= 4.5', contrast >= 4.5, contrast.toFixed(2));
+
+// Disclosure: double toggle open->close->open, and closed panel hidden from AT tree
+await page.locator('#config-collapsible').click();
+await page.waitForSelector('.content.open');
+const vis1 = await page.evaluate(() => document.querySelector('.content').checkVisibility({ checkVisibilityCSS: true }));
+await page.locator('#config-collapsible').click();
+await page.waitForTimeout(400);
+const vis2 = await page.evaluate(() => document.querySelector('.content').checkVisibility({ checkVisibilityCSS: true }));
+check('disclosure: toggle open/close changes visibility', vis1 === true && vis2 === false, `${vis1}->${vis2}`);
+
+// Business journey INDÉPENDANT : changer le pays via le panneau config → POST /config → persistance
+await page.goto(`${BASE}/`, { waitUntil: 'networkidle' });
+await page.locator('#config-collapsible').click();
+await page.waitForSelector('.content.open');
+await page.selectOption('#config-country', 'FR');
+await Promise.all([
+  page.waitForNavigation({ waitUntil: 'networkidle' }),
+  page.locator('#config-submit').click(),
+]);
+const persisted = await page.evaluate(async () => {
+  const r = await fetch('/config');
+  const cfg = JSON.parse(await r.text());
+  return cfg.country;
+});
+check('journey: config POST persists country=FR', persisted === 'FR', `country=${persisted}`);
+
+await browser.close();
+const failed = results.filter(r => !r.ok);
+console.log(`\nEVAL-FINAL: ${results.length - failed.length}/${results.length} passed`);
+process.exit(failed.length ? 1 : 0);
