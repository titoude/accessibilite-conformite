+
+/* Accessibility helpers */
+.visually-hidden {
+    position: absolute;
+    width: 1px;
+    height: 1px;
+    padding: 0;
+    margin: -1px;
+    overflow: hidden;
+    clip: rect(0 0 0 0);
+    white-space: nowrap;
+    border: 0;
+}
+
+.skip-link {
+    position: absolute;
+    top: -100px;
+    left: 8px;
+    padding: 8px;
+    z-index: 100;
+    text-decoration: underline;
+}
+
+.skip-link:focus {
+    top: 8px;
+}
+
+.link {
+    text-decoration: underline;
+}
